#!/bin/bash

################################################################################
# 🎨 GymBro Pre-Commit Theme Check
#
# Prevents committing files with hardcoded color violations
# Auto-installed by: scripts/install_hooks.sh
#
# This hook checks staged Dart files for hardcoded Colors.* usage
# (excluding Colors.transparent which is legitimate)
#
################################################################################

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Get list of staged Dart files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "\.dart$")

if [ -z "$STAGED_FILES" ]; then
    # No Dart files staged
    exit 0
fi

VIOLATIONS_FOUND=0
VIOLATION_FILES=()

echo ""
echo -e "${BLUE}🎨 Checking for hardcoded color violations...${NC}"
echo ""

# Check each staged file
for FILE in $STAGED_FILES; do
    # Skip theme files (they legitimately define colors)
    if [[ "$FILE" == *"theme/app_theme.dart"* ]] || \
       [[ "$FILE" == *"color_scheme_extensions.dart"* ]] || \
       [[ "$FILE" == *"build_context_extensions.dart"* ]]; then
        continue
    fi

    # Check for Colors.* but exclude Colors.transparent
    VIOLATIONS=$(git diff --cached "$FILE" | grep "^+" | grep -v "^+++" | grep "Colors\." | grep -v "Colors\.transparent" | wc -l | tr -d ' ')

    if [ "$VIOLATIONS" -gt 0 ]; then
        VIOLATIONS_FOUND=$((VIOLATIONS_FOUND + VIOLATIONS))
        VIOLATION_FILES+=("$FILE")
        echo -e "${YELLOW}⚠${NC}  Found $VIOLATIONS violation(s) in: ${CYAN}$FILE${NC}"

        # Show specific violations (first 3)
        git diff --cached "$FILE" | grep "^+" | grep -v "^+++" | grep "Colors\." | grep -v "Colors\.transparent" | head -3 | while read line; do
            echo -e "   ${RED}↳${NC} $(echo "$line" | sed 's/^+//' | xargs)"
        done
        echo ""
    fi
done

if [ "$VIOLATIONS_FOUND" -gt 0 ]; then
    echo ""
    echo -e "${RED}╔════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║${NC}  ❌ ${YELLOW}COMMIT BLOCKED${NC} - Hardcoded Color Violations Found     ${RED}║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}Found $VIOLATIONS_FOUND hardcoded color violation(s) in ${#VIOLATION_FILES[@]} file(s):${NC}"
    echo ""

    for FILE in "${VIOLATION_FILES[@]}"; do
        echo -e "  • ${CYAN}$FILE${NC}"
    done

    echo ""
    echo -e "${BLUE}📋 To fix these violations:${NC}"
    echo ""
    echo -e "  ${GREEN}✓${NC} Automatic fix (recommended):"
    echo -e "    ${CYAN}./scripts/fix_theme_violations.sh --file <path>${NC}"
    echo ""
    echo -e "  ${GREEN}✓${NC} Manual fix - Replace hardcoded colors:"
    echo -e "    ${RED}Colors.blue${NC}   → ${GREEN}context.colors.primary${NC}"
    echo -e "    ${RED}Colors.orange${NC} → ${GREEN}context.colors.secondary${NC}"
    echo -e "    ${RED}Colors.red${NC}    → ${GREEN}context.colors.error${NC}"
    echo -e "    ${RED}Colors.green${NC}  → ${GREEN}context.colors.success${NC}"
    echo ""
    echo -e "  ${YELLOW}ℹ${NC}  Import required:"
    echo -e "    ${CYAN}import 'package:gymbro_flutter_new/shared/presentation/extensions/build_context_extensions.dart';${NC}"
    echo ""
    echo -e "${BLUE}📖 See documentation:${NC} ${CYAN}scripts/THEME_FIX_README.md${NC}"
    echo ""
    echo -e "${YELLOW}⚠${NC}  To bypass this check (NOT RECOMMENDED):"
    echo -e "    ${CYAN}git commit --no-verify${NC}"
    echo ""

    exit 1
fi

echo -e "${GREEN}✓${NC}  No hardcoded color violations found"
echo ""
exit 0
