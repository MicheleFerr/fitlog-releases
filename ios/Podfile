# Uncomment this line to define a global platform for your project
platform :ios, '18.6'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Speed up pod installation with parallel downloads and disable deterministic UUIDs
install! 'cocoapods',
  :deterministic_uuids => false,
  :warn_for_unused_master_specs_repo => false

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Force compatible GoogleUtilities version (risolve conflitto Firebase/Google Sign In)
  pod 'GoogleUtilities', '~> 8.0'
  pod 'GoogleSignIn', '~> 8.0'
  
  # Firebase BoM compatibility enforcement - stable versions
  pod 'Firebase/Core', '~> 11.15'
  pod 'Firebase/Auth', '~> 11.15'
  pod 'Firebase/Firestore', '~> 11.15'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Speed up builds with parallel compilation
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CC'] = 'clang'
    config.build_settings['LD'] = 'clang'
    config.build_settings['CXX'] = 'clang++'
    config.build_settings['LDPLUSPLUS'] = 'clang++'
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Fix for Firebase/Google Sign In version conflicts 2025
    target.build_configurations.each do |config|
      # CRITICAL: Disable Explicit Modules for Xcode 16 compatibility with CocoaPods
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'

      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.6'
      
      # Force GoogleUtilities 8.x compatibility
      if target.name.include?('GoogleUtilities') || target.name.include?('GoogleSignIn') || target.name.include?('Firebase')
        config.build_settings['DEFINES_MODULE'] = 'YES'
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
      
      # Comprehensive fix for gRPC and abseil compilation issues
      if target.name.include?('gRPC') || target.name.include?('abseil') || target.name.include?('Protobuf') || target.name == 'BoringSSL-GRPC'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
          'GRPC_NO_XDS=1',
          'GPB_USE_PROTOBUF_FRAMEWORK_IMPORTS=1'
        ]
        
        # Remove problematic compiler flags and replace with compatible ones
        config.build_settings.delete('OTHER_CPLUSPLUSFLAGS')
        config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-shorten-64-to-32'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++14'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        
        # Remove the problematic -G flag from GCC_WARN_INHIBIT_ALL_WARNINGS
        config.build_settings.delete('GCC_WARN_INHIBIT_ALL_WARNINGS')
        config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
        config.build_settings['WARNING_CFLAGS'] = '$(inherited) -w'
        
        # Force use of system compiler
        config.build_settings['GCC_VERSION'] = 'com.apple.compilers.llvm.clang.1_0'
      end
      
      # Fix for arm64 architecture issues - UPDATED for Firebase compatibility
      config.build_settings.delete('ARCHS')
      if target.name.include?('Firebase')
        # Special handling for Firebase frameworks
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        config.build_settings['EXCLUDED_ARCHS[sdk=iphoneos*]'] = 'i386 x86_64'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
        config.build_settings['VALID_ARCHS'] = 'arm64'
      else
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = ''
        config.build_settings['EXCLUDED_ARCHS[sdk=iphoneos*]'] = 'i386 x86_64'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        config.build_settings['VALID_ARCHS'] = 'arm64'
      end
      
      # Additional stability fixes
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
    end
  end
end
