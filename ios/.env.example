# 🔐 FitLog Environment Variables Template
#
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env file to version control!
#
# Setup Instructions:
# 1. cp .env.example .env
# 2. Fill in your credentials below
# 3. Run: flutter run (automatically loads .env)

# ═══════════════════════════════════════════════════════════════════════════
# Firebase Configuration (iOS)
# ═══════════════════════════════════════════════════════════════════════════
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key_here
FIREBASE_IOS_APP_ID=your_firebase_ios_app_id_here
FIREBASE_IOS_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_IOS_PROJECT_ID=your_project_id_here
FIREBASE_IOS_STORAGE_BUCKET=your_storage_bucket_here
FIREBASE_IOS_BUNDLE_ID=com.yourdomain.yourapp

# ═══════════════════════════════════════════════════════════════════════════
# AI Coach (OpenRouter API)
# ═══════════════════════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Production: Use --dart-define instead of .env
