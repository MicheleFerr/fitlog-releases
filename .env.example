# 🔐 Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Firebase Configuration (iOS)
FIREBASE_API_KEY_IOS=your-ios-api-key-here
FIREBASE_APP_ID_IOS=your-ios-app-id-here
FIREBASE_MESSAGING_SENDER_ID_IOS=your-ios-sender-id-here
FIREBASE_PROJECT_ID_IOS=your-project-id-here
FIREBASE_STORAGE_BUCKET_IOS=your-storage-bucket-here

# Firebase Configuration (Android)
FIREBASE_API_KEY_ANDROID=your-android-api-key-here
FIREBASE_APP_ID_ANDROID=your-android-app-id-here
FIREBASE_MESSAGING_SENDER_ID_ANDROID=your-android-sender-id-here
FIREBASE_PROJECT_ID_ANDROID=your-project-id-here
FIREBASE_STORAGE_BUCKET_ANDROID=your-storage-bucket-here

# Firebase Configuration (Web - if applicable)
FIREBASE_API_KEY_WEB=your-web-api-key-here
FIREBASE_APP_ID_WEB=your-web-app-id-here
FIREBASE_MESSAGING_SENDER_ID_WEB=your-web-sender-id-here
FIREBASE_PROJECT_ID_WEB=your-project-id-here
FIREBASE_STORAGE_BUCKET_WEB=your-storage-bucket-here
FIREBASE_MEASUREMENT_ID_WEB=your-measurement-id-here

# API Keys (Third-party services)
# AI Coach (OpenRouter API) - REQUIRED for AI Coach feature
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Optional third-party services
# OPENAI_API_KEY=your-openai-api-key-here
# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

# Environment
ENV=development  # development, staging, production
