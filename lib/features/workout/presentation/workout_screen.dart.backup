  void _showImportFromJson(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    final TextEditingController jsonController = TextEditingController();

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(l10n.importFromJSON),
        content: SizedBox(
          width: double.maxFinite,
          child: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: Theme.of(context).colorScheme.surfaceContainerHighest,
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Icon(
                            Icons.info_outline,
                            color: Theme.of(context).colorScheme.primary,
                            size: 20,
                          ),
                          const SizedBox(width: 8),
                          Text(
                            'Formato JSON',
                            style: Theme.of(context).textTheme.titleSmall?.copyWith(
                              fontWeight: FontWeight.bold,
                              color: Theme.of(context).colorScheme.primary,
                            ),
                          ),
                        ],
                      ),
                      const SizedBox(height: 8),
                      Text(
                        'Incolla qui il JSON del tuo template di allenamento',
                        style: Theme.of(context).textTheme.bodySmall,
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 16),
                SizedBox(
                  height: 200,
                  child: TextField(
                    controller: jsonController,
                    maxLines: null,
                    expands: true,
                    decoration: const InputDecoration(
                      hintText: '{\n  "name": "My Workout",\n  "description": "...",\n  "exercises": [...]\n}',
                      border: OutlineInputBorder(),
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: Text(l10n.cancel),
          ),
          FilledButton(
            onPressed: () async {
              Navigator.pop(context);
              if (jsonController.text.trim().isNotEmpty) {
                // Naviga alla schermata template per processare l'import
                Navigator.of(context).push(
                  MaterialPageRoute(
                    builder: (context) => const WorkoutTemplatesScreen(),
                  ),
                );

                // Mostra feedback temporaneo
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text('Usa la funzione import nella schermata template'),
                    backgroundColor: Theme.of(context).colorScheme.primary,
                  ),
                );
              }
            },
            child: Text('Import'),
          ),
        ],
      ),
    );
  }

