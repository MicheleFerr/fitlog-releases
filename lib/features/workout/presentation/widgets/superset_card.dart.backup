import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:gymbro_flutter_new/features/workout/domain/entities/exercise.dart';
import 'package:gymbro_flutter_new/shared/presentation/l10n/generated/app_localizations.dart';
import 'package:gymbro_flutter_new/shared/presentation/providers/app_config_provider.dart';
import 'exercise_options_modal.dart';
import 'exercise_history_bottom_sheet.dart';
import 'rpe_selector_bottom_sheet.dart';

/// Tier-1 SupersetCard che mostra tutti gli esercizi del superset in una singola card
class SupersetCard extends ConsumerStatefulWidget {
  final SupersetExercise superset;
  final int index;
  final VoidCallback onTap;
  final VoidCallback onDelete;
  final VoidCallback? onEdit;
  final VoidCallback? onReplace;
  final Function(ExerciseSet)? onSetUpdate;
  final Function(ExerciseSet)? onSetToggleComplete;
  final Function(Exercise)? onExerciseUpdate;
  final Function(SupersetSet)? onSupersetSetUpdate;
  final bool isReorderMode;

  const SupersetCard({
    super.key,
    required this.superset,
    required this.index,
    required this.onTap,
    required this.onDelete,
    this.onEdit,
    this.onReplace,
    this.onSetUpdate,
    this.onSetToggleComplete,
    this.onExerciseUpdate,
    this.onSupersetSetUpdate,
    this.isReorderMode = false,
  });

  @override
  ConsumerState<SupersetCard> createState() => _SupersetCardState();
}

class _SupersetCardState extends ConsumerState<SupersetCard> {
  bool _isExpanded = false;

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    final config = ref.watch(appConfigProvider);
    
    return Dismissible(
      key: Key('superset_${widget.superset.name}'),
      direction: DismissDirection.endToStart,
      confirmDismiss: (direction) async {
        // Don't actually dismiss - just handle the gesture
        return false;
      },
      background: Container(
        alignment: Alignment.centerRight,
        padding: const EdgeInsets.only(right: 16),
        decoration: BoxDecoration(
          gradient: LinearGradient(
            colors: [
              Colors.transparent,
              Theme.of(context).colorScheme.error.withValues(alpha: 0.3),
            ],
          ),
          borderRadius: BorderRadius.circular(12),
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            _buildSwipeAction(
              context,
              icon: Icons.swap_horiz,
              label: l10n.replace,
              color: Colors.green,
              onTap: () {
                HapticFeedback.mediumImpact();
                if (widget.onReplace != null) widget.onReplace!();
              },
            ),
            const SizedBox(width: 8),
            _buildSwipeAction(
              context,
              icon: Icons.edit,
              label: l10n.edit,
              color: Colors.blue,
              onTap: () {
                HapticFeedback.mediumImpact();
                if (widget.onEdit != null) widget.onEdit!();
              },
            ),
            const SizedBox(width: 8),
            _buildSwipeAction(
              context,
              icon: Icons.delete,
              label: l10n.delete,
              color: Theme.of(context).colorScheme.error,
              onTap: () {
                HapticFeedback.mediumImpact();
                _showDeleteConfirmation(context);
              },
            ),
          ],
        ),
      ),
      child: Card(
        elevation: 2,
        child: InkWell(
          onTap: widget.isReorderMode ? null : widget.onTap,
          onLongPress: widget.isReorderMode ? null : () => _showSupersetOptions(context),
          borderRadius: BorderRadius.circular(12),
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // Header del superset
                _buildSupersetHeader(context, l10n),
                const SizedBox(height: 12),
                
                // Lista degli esercizi nel superset
                _buildExercisesList(context, l10n),
                const SizedBox(height: 16),
                
                // Set del superset
                _buildSupersetSets(context, l10n, config),
                
                // Note del superset (se presenti)
                if (widget.superset.notes?.isNotEmpty == true) ...[
                  const SizedBox(height: 12),
                  _buildNotesSection(context, l10n),
                ],
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildSwipeAction(
    BuildContext context, {
    required IconData icon,
    required String label,
    required Color color,
    required VoidCallback onTap,
  }) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        width: 60,
        height: 60,
        decoration: BoxDecoration(
          color: color,
          borderRadius: BorderRadius.circular(12),
        ),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(icon, color: Colors.white, size: 20),
            const SizedBox(height: 2),
            Text(
              label,
              style: const TextStyle(
                color: Colors.white,
                fontSize: 10,
                fontWeight: FontWeight.w500,
              ),
              textAlign: TextAlign.center,
            ),
          ],
        ),
      ),
    );
  }

  void _showDeleteConfirmation(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(l10n.deleteSuperset ?? 'Delete Superset'),
        content: Text('Are you sure you want to delete this superset?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: Text(l10n.cancel),
          ),
          TextButton(
            onPressed: () {
              Navigator.pop(context);
              widget.onDelete();
            },
            child: Text(l10n.delete),
          ),
        ],
      ),
    );
  }

  Widget _buildSupersetHeader(BuildContext context, AppLocalizations l10n) {
    return Row(
      children: [
        // Icona superset
        Container(
          width: 40,
          height: 40,
          decoration: BoxDecoration(
            gradient: LinearGradient(
              colors: [
                Theme.of(context).colorScheme.secondary,
                Theme.of(context).colorScheme.secondary.withValues(alpha: 0.7),
              ],
            ),
            shape: BoxShape.circle,
          ),
          child: const Icon(
            Icons.link,
            color: Colors.white,
            size: 20,
          ),
        ),
        const SizedBox(width: 12),
        
        // Titolo e badge
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  // Badge SUPERSET
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                    decoration: BoxDecoration(
                      color: Theme.of(context).colorScheme.secondary.withValues(alpha: 0.1),
                      borderRadius: BorderRadius.circular(6),
                      border: Border.all(
                        color: Theme.of(context).colorScheme.secondary.withValues(alpha: 0.3),
                        width: 1,
                      ),
                    ),
                    child: Text(
                      l10n.exerciseTypeSuperset.toUpperCase(),
                      style: TextStyle(
                        fontSize: 10,
                        fontWeight: FontWeight.bold,
                        color: Theme.of(context).colorScheme.secondary,
                        letterSpacing: 0.5,
                      ),
                    ),
                  ),
                  const SizedBox(width: 8),
                  
                  // Nome del superset
                  Expanded(
                    child: Text(
                      widget.superset.name,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: Theme.of(context).textTheme.titleMedium?.copyWith(
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 4),
              
              // Info sui set
              Text(
                '${widget.superset.supersetSets.length} rounds • ${widget.superset.exercises.length} exercises',
                style: Theme.of(context).textTheme.bodySmall?.copyWith(
                  color: Theme.of(context).colorScheme.onSurface,
                ),
              ),
            ],
          ),
        ),
        
        // Menu button
        IconButton(
          onPressed: () => _showSupersetOptions(context),
          icon: const Icon(Icons.more_vert),
          tooltip: 'Options',
        ),
      ],
    );
  }

  Widget _buildExercisesList(BuildContext context, AppLocalizations l10n) {
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Theme.of(context).colorScheme.surfaceContainer.withValues(alpha: 0.3),
        borderRadius: BorderRadius.circular(8),
        border: Border.all(
          color: Theme.of(context).colorScheme.outline.withValues(alpha: 0.2),
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(
                Icons.fitness_center,
                size: 16,
                color: Theme.of(context).colorScheme.primary,
              ),
              const SizedBox(width: 6),
              Text(
                'Exercises',
                style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                  fontWeight: FontWeight.w600,
                  color: Theme.of(context).colorScheme.primary,
                ),
              ),
              const Spacer(),

              // Expand/collapse button - hidden in reorder mode
              if (!widget.isReorderMode)
                GestureDetector(
                  onTap: () {
                    setState(() {
                      _isExpanded = !_isExpanded;
                    });
                    HapticFeedback.lightImpact();
                  },
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Text(
                        _isExpanded ? 'Less' : 'More',
                        style: Theme.of(context).textTheme.bodySmall?.copyWith(
                          color: Theme.of(context).colorScheme.primary,
                          fontWeight: FontWeight.w500,
                        ),
                      ),
                      const SizedBox(width: 4),
                      Icon(
                        _isExpanded ? Icons.keyboard_arrow_up : Icons.keyboard_arrow_down,
                        size: 16,
                        color: Theme.of(context).colorScheme.primary,
                      ),
                    ],
                  ),
                )
              else
                // Reorder mode indicator
                Text(
                  '${widget.superset.exercises.length} esercizi',
                  style: Theme.of(context).textTheme.bodySmall?.copyWith(
                    color: Theme.of(context).colorScheme.onSurfaceVariant,
                    fontWeight: FontWeight.w500,
                  ),
                ),
            ],
          ),
          const SizedBox(height: 8),
          
          // Lista esercizi - always collapsed in reorder mode
          if (!widget.isReorderMode && _isExpanded) ...[
            ...widget.superset.exercises.asMap().entries.map((entry) {
              final index = entry.key;
              final exercise = entry.value;
              return Padding(
                padding: EdgeInsets.only(bottom: index < widget.superset.exercises.length - 1 ? 8 : 0),
                child: _buildExerciseRow(context, exercise, index + 1),
              );
            }),
          ] else ...[
            // Vista compatta - prima riga degli esercizi (or reorder mode)
            _buildCompactExercisesList(context),
          ],
        ],
      ),
    );
  }

  Widget _buildExerciseRow(BuildContext context, Exercise exercise, int number) {
    return InkWell(
      onTap: () => _showExerciseOptions(context, exercise),
      borderRadius: BorderRadius.circular(6),
      child: Container(
        padding: const EdgeInsets.all(8),
        decoration: BoxDecoration(
          color: Theme.of(context).colorScheme.surface,
          borderRadius: BorderRadius.circular(6),
          border: Border.all(
            color: Theme.of(context).colorScheme.outline.withValues(alpha: 0.1),
          ),
        ),
        child: Row(
          children: [
            // Numero esercizio
            Container(
              width: 24,
              height: 24,
              decoration: BoxDecoration(
                color: Theme.of(context).colorScheme.primary.withValues(alpha: 0.1),
                shape: BoxShape.circle,
              ),
              child: Center(
                child: Text(
                  '$number',
                  style: TextStyle(
                    fontSize: 12,
                    fontWeight: FontWeight.bold,
                    color: Theme.of(context).colorScheme.primary,
                  ),
                ),
              ),
            ),
            const SizedBox(width: 8),
            
            // Nome esercizio
            Expanded(
              child: Text(
                exercise.name,
                style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                  fontWeight: FontWeight.w500,
                ),
              ),
            ),
            
            // Icona per indicare che è cliccabile
            Icon(
              Icons.info_outline,
              size: 16,
              color: Theme.of(context).colorScheme.primary.withValues(alpha: 0.7),
            ),
            const SizedBox(width: 4),
            
            // Categoria
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
              decoration: BoxDecoration(
                color: Theme.of(context).colorScheme.primaryContainer,
                borderRadius: BorderRadius.circular(4),
              ),
              child: Text(
                exercise.category.name.toUpperCase(),
                style: TextStyle(
                  fontSize: 10,
                  fontWeight: FontWeight.bold,
                  color: Theme.of(context).colorScheme.onPrimaryContainer,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildCompactExercisesList(BuildContext context) {
    return Wrap(
      spacing: 8,
      runSpacing: 4,
      children: widget.superset.exercises.asMap().entries.map((entry) {
        final index = entry.key;
        final exercise = entry.value;
        return Container(
          padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
          decoration: BoxDecoration(
            color: Theme.of(context).colorScheme.primary.withValues(alpha: 0.1),
            borderRadius: BorderRadius.circular(12),
          ),
          child: Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              Text(
                '${index + 1}.',
                style: TextStyle(
                  fontSize: 12,
                  fontWeight: FontWeight.bold,
                  color: Theme.of(context).colorScheme.primary,
                ),
              ),
              const SizedBox(width: 4),
              Text(
                exercise.name,
                style: Theme.of(context).textTheme.bodySmall?.copyWith(
                  fontWeight: FontWeight.w500,
                ),
              ),
            ],
          ),
        );
      }).toList(),
    );
  }

  Widget _buildSupersetSets(BuildContext context, AppLocalizations l10n, config) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            Icon(
              Icons.repeat,
              size: 16,
              color: Theme.of(context).colorScheme.primary,
            ),
            const SizedBox(width: 6),
            Text(
              'Sets (${widget.superset.supersetSets.where((s) => s.isFullyCompleted).length}/${widget.superset.supersetSets.length})',
              style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                fontWeight: FontWeight.w600,
                color: Theme.of(context).colorScheme.primary,
              ),
            ),
          ],
        ),
        const SizedBox(height: 12),
        
        ...widget.superset.supersetSets.asMap().entries.map((entry) {
          final index = entry.key;
          final supersetSet = entry.value;
          return Padding(
            padding: EdgeInsets.only(bottom: index < widget.superset.supersetSets.length - 1 ? 12 : 0),
            child: _buildEnhancedSupersetSetRow(context, supersetSet, index + 1, l10n, config),
          );
        }),
      ],
    );
  }


  Widget _buildNotesSection(BuildContext context, AppLocalizations l10n) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Theme.of(context).colorScheme.surfaceContainer.withValues(alpha: 0.3),
        borderRadius: BorderRadius.circular(8),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(
                Icons.note,
                size: 16,
                color: Theme.of(context).colorScheme.onSurface,
              ),
              const SizedBox(width: 6),
              Text(
                l10n.notes,
                style: Theme.of(context).textTheme.bodySmall?.copyWith(
                  fontWeight: FontWeight.w600,
                  color: Theme.of(context).colorScheme.onSurface,
                ),
              ),
            ],
          ),
          const SizedBox(height: 6),
          Text(
            widget.superset.notes!,
            style: Theme.of(context).textTheme.bodySmall,
          ),
        ],
      ),
    );
  }

  void _showSupersetOptions(BuildContext context) {
    HapticFeedback.mediumImpact();
    showModalBottomSheet(
      context: context,
      builder: (context) => Container(
        padding: const EdgeInsets.all(16),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            ListTile(
              leading: const Icon(Icons.edit),
              title: const Text('Edit Superset'),
              onTap: () {
                Navigator.pop(context);
                if (widget.onEdit != null) widget.onEdit!();
              },
            ),
            ListTile(
              leading: const Icon(Icons.copy),
              title: const Text('Duplicate'),
              onTap: () {
                Navigator.pop(context);
                // TODO: Implement duplicate functionality
              },
            ),
            ListTile(
              leading: Icon(Icons.delete, color: Theme.of(context).colorScheme.error),
              title: Text(
                'Delete Superset',
                style: TextStyle(color: Theme.of(context).colorScheme.error),
              ),
              onTap: () {
                Navigator.pop(context);
                _showDeleteConfirmation(context);
              },
            ),
          ],
        ),
      ),
    );
  }


  Widget _buildEnhancedSupersetSetRow(BuildContext context, SupersetSet supersetSet, int setNumber, AppLocalizations l10n, config) {
    final isFullyCompleted = supersetSet.isFullyCompleted;
    
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: isFullyCompleted 
            ? Theme.of(context).colorScheme.primaryContainer.withValues(alpha: 0.2)
            : Theme.of(context).colorScheme.surfaceContainer.withValues(alpha: 0.3),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: isFullyCompleted 
              ? Theme.of(context).colorScheme.primary.withValues(alpha: 0.3)
              : Theme.of(context).colorScheme.outline.withValues(alpha: 0.2),
          width: isFullyCompleted ? 2 : 1,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Set header
          Row(
            children: [
              Container(
                width: 28,
                height: 28,
                decoration: BoxDecoration(
                  color: isFullyCompleted 
                      ? Theme.of(context).colorScheme.primary
                      : Theme.of(context).colorScheme.outline.withValues(alpha: 0.3),
                  shape: BoxShape.circle,
                ),
                child: Center(
                  child: isFullyCompleted
                      ? const Icon(Icons.check, color: Colors.white, size: 16)
                      : Text(
                          '$setNumber',
                          style: TextStyle(
                            fontSize: 12,
                            fontWeight: FontWeight.bold,
                            color: Theme.of(context).colorScheme.onSurface,
                          ),
                        ),
                ),
              ),
              const SizedBox(width: 10),
              Text(
                'Set $setNumber',
                style: Theme.of(context).textTheme.titleSmall?.copyWith(
                  fontWeight: FontWeight.w600,
                ),
              ),
              const Spacer(),
              Text(
                '${supersetSet.completedExercisesCount}/${supersetSet.exerciseData.length} completed',
                style: Theme.of(context).textTheme.bodySmall?.copyWith(
                  color: Theme.of(context).colorScheme.onSurfaceVariant,
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          
          // Exercise rows with individual toggles
          ...widget.superset.exercises.map((exercise) {
            final exerciseData = supersetSet.exerciseData[exercise.id];
            if (exerciseData == null) return const SizedBox.shrink();
            
            return _buildExerciseSetRow(
              context, 
              exercise, 
              exerciseData, 
              supersetSet,
              setNumber,
              l10n,
              config,
            );
          }),
        ],
      ),
    );
  }

  Widget _buildExerciseSetRow(
    BuildContext context, 
    Exercise exercise, 
    SupersetExerciseData exerciseData,
    SupersetSet supersetSet,
    int setNumber,
    AppLocalizations l10n,
    config,
  ) {
    return GestureDetector(
      onTap: () => _handleExerciseToggle(context, exercise, exerciseData, supersetSet),
      child: Container(
        margin: const EdgeInsets.only(bottom: 8),
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
        decoration: BoxDecoration(
          color: exerciseData.isCompleted 
              ? Theme.of(context).colorScheme.tertiary.withValues(alpha: 0.1)
              : Theme.of(context).colorScheme.surface,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(
            color: exerciseData.isCompleted 
                ? Theme.of(context).colorScheme.tertiary.withValues(alpha: 0.3)
                : Theme.of(context).colorScheme.outline.withValues(alpha: 0.1),
          ),
        ),
        child: Row(
          children: [
            // Weight display
            Expanded(
              flex: 2,
              child: Row(
                children: [
                  Text(
                    '${(exerciseData.actualWeight ?? exerciseData.targetWeight ?? 0).toStringAsFixed(1)}',
                    style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                      fontWeight: FontWeight.bold,
                      color: exerciseData.isCompleted 
                          ? Theme.of(context).colorScheme.tertiary
                          : Theme.of(context).colorScheme.onSurface,
                    ),
                  ),
                  Text(
                    'kg',
                    style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                      color: Theme.of(context).colorScheme.onSurfaceVariant,
                    ),
                  ),
                ],
              ),
            ),
            
            // Reps display
            Expanded(
              flex: 2,
              child: Row(
                children: [
                  Text(
                    '×',
                    style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                      color: Theme.of(context).colorScheme.onSurfaceVariant,
                    ),
                  ),
                  const SizedBox(width: 4),
                  Text(
                    '${exerciseData.actualReps ?? exerciseData.targetReps ?? 0}',
                    style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                      fontWeight: FontWeight.bold,
                      color: exerciseData.isCompleted 
                          ? Theme.of(context).colorScheme.tertiary
                          : Theme.of(context).colorScheme.onSurface,
                    ),
                  ),
                  Text(
                    ' reps',
                    style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                      color: Theme.of(context).colorScheme.onSurfaceVariant,
                    ),
                  ),
                ],
              ),
            ),
            
            // RPE display (if available)
            if (exerciseData.rpe != null)
              Expanded(
                flex: 1,
                child: Container(
                  padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                  decoration: BoxDecoration(
                    color: _getRPEColor(exerciseData.rpe!).withValues(alpha: 0.2),
                    borderRadius: BorderRadius.circular(4),
                  ),
                  child: Text(
                    'RPE ${exerciseData.rpe}',
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: FontWeight.bold,
                      color: _getRPEColor(exerciseData.rpe!),
                    ),
                    textAlign: TextAlign.center,
                  ),
                ),
              )
            else
              const Expanded(flex: 1, child: SizedBox()),
            
            const SizedBox(width: 12),
            
            // Completion toggle on the right (like single cards)
            Container(
              width: 24,
              height: 24,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                border: Border.all(
                  color: exerciseData.isCompleted 
                      ? Theme.of(context).colorScheme.tertiary
                      : Theme.of(context).colorScheme.outline,
                  width: 2,
                ),
                color: exerciseData.isCompleted 
                    ? Theme.of(context).colorScheme.tertiary
                    : Colors.transparent,
              ),
              child: exerciseData.isCompleted 
                  ? const Icon(Icons.check, size: 14, color: Colors.white)
                  : null,
            ),
          ],
        ),
      ),
    );
  }

  Color _getRPEColor(int rpe) {
    if (rpe <= 6) return Colors.green;
    if (rpe <= 7) return Colors.lightGreen;
    if (rpe <= 8) return Colors.orange;
    if (rpe <= 9) return Colors.deepOrange;
    return Colors.red;
  }

  void _handleExerciseToggle(
    BuildContext context, 
    Exercise exercise, 
    SupersetExerciseData exerciseData,
    SupersetSet supersetSet,
  ) {
    HapticFeedback.lightImpact();
    
    if (!exerciseData.isCompleted) {
      // Apri modal di registrazione con swipe tra esercizi
      _openSupersetRegistrationModal(context, exercise, exerciseData, supersetSet);
    } else {
      // Toggle completamento (deseleziona)
      final updatedData = exerciseData.copyWith(isCompleted: false);
      final updatedExerciseData = Map<String, SupersetExerciseData>.from(supersetSet.exerciseData);
      updatedExerciseData[exercise.id] = updatedData;
      
      final updatedSet = supersetSet.copyWith(
        exerciseData: updatedExerciseData,
        isCompleted: false,
      );
      
      widget.onSupersetSetUpdate?.call(updatedSet);
    }
  }

  void _openSupersetRegistrationModal(
    BuildContext context,
    Exercise exercise,
    SupersetExerciseData exerciseData,
    SupersetSet supersetSet,
  ) {
    debugPrint('🚀 SUPERSET DEBUG: Opening modal per singolo esercizio con swipe navigation');
    HapticFeedback.mediumImpact();
    
    // Use a PageView wrapper to handle swipe navigation between exercises
    _showSupersetModalWithNavigation(context, exercise, supersetSet);
  }

  void _showSupersetModalWithNavigation(
    BuildContext context,
    Exercise initialExercise,
    SupersetSet supersetSet,
  ) {
    final pageController = PageController(
      initialPage: widget.superset.exercises.indexWhere((e) => e.id == initialExercise.id),
    );

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      barrierColor: Colors.black54,
      constraints: BoxConstraints(
        maxHeight: MediaQuery.of(context).size.height * 0.85,
      ),
      builder: (context) => StatefulBuilder(
        builder: (context, setModalState) {
          int currentPageIndex = widget.superset.exercises.indexWhere((e) => e.id == initialExercise.id);
          
          return Container(
            decoration: BoxDecoration(
              color: Theme.of(context).scaffoldBackgroundColor,
              borderRadius: const BorderRadius.vertical(top: Radius.circular(20)),
            ),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
              // Handle bar
              Container(
                margin: const EdgeInsets.only(top: 12),
                width: 40,
                height: 4,
                decoration: BoxDecoration(
                  color: Theme.of(context).dividerColor,
                  borderRadius: BorderRadius.circular(2),
                ),
              ),
              
              // Exercise navigation dots/indicator
              if (widget.superset.exercises.length > 1) ...[
                const SizedBox(height: 16),
                Row(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: widget.superset.exercises.asMap().entries.map((entry) {
                    final index = entry.key;
                    final exercise = entry.value;
                    final isActive = index == currentPageIndex;
                    
                    return Container(
                      margin: const EdgeInsets.symmetric(horizontal: 4),
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Container(
                            width: isActive ? 24 : 8,
                            height: 8,
                            decoration: BoxDecoration(
                              borderRadius: BorderRadius.circular(4),
                              color: isActive 
                                  ? Theme.of(context).colorScheme.primary
                                  : Theme.of(context).colorScheme.primary.withValues(alpha: 0.3),
                            ),
                          ),
                          const SizedBox(height: 4),
                          Text(
                            exercise.name.length > 12 
                                ? '${exercise.name.substring(0, 12)}...'
                                : exercise.name,
                            style: TextStyle(
                              fontSize: 10,
                              fontWeight: isActive ? FontWeight.w600 : FontWeight.normal,
                              color: isActive 
                                  ? Theme.of(context).colorScheme.primary
                                  : Theme.of(context).colorScheme.onSurfaceVariant,
                            ),
                          ),
                        ],
                      ),
                    );
                  }).toList(),
                ),
              ],
              
              // PageView with individual UnifiedSetInputModal for each exercise
              Expanded(
                child: PageView.builder(
                  controller: pageController,
                  onPageChanged: (index) {
                    setModalState(() {
                      currentPageIndex = index;
                    });
                  },
                  itemCount: widget.superset.exercises.length,
                  itemBuilder: (context, index) {
                    final exercise = widget.superset.exercises[index];
                    final exerciseData = supersetSet.exerciseData[exercise.id]!;
                    
                    final exerciseSet = ExerciseSet(
                      setNumber: supersetSet.setNumber,
                      weight: exerciseData.targetWeight ?? exerciseData.actualWeight,
                      reps: exerciseData.targetReps,
                      actualReps: exerciseData.actualReps,
                      rpe: exerciseData.rpe,
                      isCompleted: exerciseData.isCompleted,
                      notes: exerciseData.notes,
                    );
                    
                    return RpeSelectorBottomSheet(
                      set: exerciseSet,
                      targetReps: exerciseData.targetReps ?? 0,
                      isPartOfSuperset: true,
                      supersetName: widget.superset.name,
                      supersetExercises: widget.superset.exercises,
                      supersetSet: supersetSet,
                      currentExerciseIndex: index,
                      onConfirm: (actualReps, actualWeight, rpe) {
                        // Create updated ExerciseSet from RPE selector data
                        final updatedExerciseSet = exerciseSet.copyWith(
                          actualReps: actualReps,
                          weight: actualWeight,
                          rpe: rpe,
                          isCompleted: true,
                        );
                        // Update this specific exercise and close
                        _updateSingleExerciseInSuperset(exercise, updatedExerciseSet, supersetSet);
                        Navigator.of(context).pop();
                      },
                      onSupersetCompleteAll: (allExerciseData) {
                        // Update all exercises in the superset with their completion data in a single batch
                        final updatedExerciseData = Map<String, SupersetExerciseData>.from(supersetSet.exerciseData);
                        
                        for (int exerciseIndex = 0; exerciseIndex < widget.superset.exercises.length; exerciseIndex++) {
                          final completeData = allExerciseData[exerciseIndex];
                          if (completeData == null) continue;
                          
                          final targetExercise = widget.superset.exercises[exerciseIndex];
                          final targetExerciseData = supersetSet.exerciseData[targetExercise.id]!;
                          
                          // Create updated exercise data with completion info
                          final updatedData = SupersetExerciseData(
                            exerciseId: targetExercise.id,
                            exerciseName: targetExercise.name,
                            targetReps: targetExerciseData.targetReps,
                            actualReps: completeData.actualReps,
                            targetWeight: targetExerciseData.targetWeight,
                            actualWeight: completeData.actualWeight,
                            rpe: completeData.rpe,
                            isCompleted: true,
                            notes: targetExerciseData.notes,
                          );
                          
                          updatedExerciseData[targetExercise.id] = updatedData;
                        }
                        
                        // Check if all exercises are now completed
                        final allCompleted = updatedExerciseData.values.every((data) => data.isCompleted);
                        
                        // Single update with all changes
                        final updatedSet = supersetSet.copyWith(
                          exerciseData: updatedExerciseData,
                          isCompleted: allCompleted,
                        );
                        widget.onSupersetSetUpdate?.call(updatedSet);

                        // Fix: Delay navigation to avoid race condition with provider update
                        Future.microtask(() {
                          if (context.mounted && Navigator.of(context).canPop()) {
                            Navigator.of(context).pop();
                          }
                        });
                      },
                    );
                  },
                ),
              ),
              ],
            ),
          );
        },
      ),
    );
  }

  void _updateSingleExerciseInSuperset(
    Exercise exercise,
    ExerciseSet updatedExerciseSet,
    SupersetSet supersetSet,
  ) {
    final updatedData = SupersetExerciseData(
      exerciseId: exercise.id,
      exerciseName: exercise.name,
      targetReps: updatedExerciseSet.reps ?? 0,
      actualReps: updatedExerciseSet.actualReps,
      targetWeight: updatedExerciseSet.weight,
      actualWeight: updatedExerciseSet.weight,
      rpe: updatedExerciseSet.rpe,
      isCompleted: updatedExerciseSet.isCompleted,
      notes: updatedExerciseSet.notes,
    );
    
    final updatedExerciseData = Map<String, SupersetExerciseData>.from(supersetSet.exerciseData);
    updatedExerciseData[exercise.id] = updatedData;
    
    final updatedSet = supersetSet.copyWith(exerciseData: updatedExerciseData);
    widget.onSupersetSetUpdate?.call(updatedSet);
  }

  void _showExerciseOptions(BuildContext context, Exercise exercise) {
    ExerciseOptionsModal.show(
      context,
      exercise,
      onHistory: () {
        showModalBottomSheet(
          context: context,
          isScrollControlled: true,
          backgroundColor: Colors.transparent,
          builder: (context) => ExerciseHistoryBottomSheet(
            exerciseName: exercise.name,
          ),
        );
      },
    );
  }
}