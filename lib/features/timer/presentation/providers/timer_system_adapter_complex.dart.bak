import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'package:gymbro_flutter_new/features/timer/domain/entities/rest_timer.dart' as legacy;
import 'package:gymbro_flutter_new/features/timer/domain/models/unified_timer_state.dart' as unified;
import 'package:gymbro_flutter_new/features/timer/presentation/providers/timer_provider.dart' as legacy_provider;
import 'package:gymbro_flutter_new/features/timer/presentation/providers/unified_timer_provider.dart' as unified_provider;
import 'package:gymbro_flutter_new/features/timer/presentation/providers/timer_feature_flags.dart';
import 'package:gymbro_flutter_new/core/utils/debug_logger.dart';

/// System Adapter that provides unified interface for timer widgets
/// Automatically switches between legacy and unified systems based on feature flags
class TimerSystemAdapter {
  static const String _debugPrefix = 'TimerSystemAdapter';
  
  /// Get current timer state (works with both systems)
  static legacy.RestTimer? getCurrentTimer(WidgetRef ref) {
    final useUnified = ref.watch(useUnifiedTimerProvider);
    
    if (useUnified) {
      final unifiedState = ref.watch(unified_provider.unifiedTimerProvider);
      return _convertFromUnified(unifiedState);
    } else {
      return ref.watch(legacy_provider.currentTimerProvider);
    }
  }
  
  /// Watch timer active state
  static bool getIsTimerActive(WidgetRef ref) {
    final useUnified = ref.watch(useUnifiedTimerProvider);
    
    if (useUnified) {
      return ref.watch(timerIsActiveProvider);
    } else {
      return ref.watch(currentTimerProvider.select((timer) => timer?.isActive ?? false));
    }
  }
  
  /// Watch timer remaining seconds
  static int getRemainingSeconds(WidgetRef ref) {
    final useUnified = ref.watch(useUnifiedTimerProvider);
    
    if (useUnified) {
      return ref.watch(timerRemainingSecondsProvider);
    } else {
      return ref.watch(currentTimerProvider.select((timer) => timer?.remainingSeconds ?? 0));
    }
  }
  
  /// Watch timer progress
  static double getProgress(WidgetRef ref) {
    final useUnified = ref.watch(useUnifiedTimerProvider);
    
    if (useUnified) {
      return ref.watch(timerProgressProvider);
    } else {
      return ref.watch(currentTimerProvider.select((timer) => timer?.progress ?? 0.0));
    }
  }
  
  /// Watch timer status
  static legacy.TimerStatus? getTimerStatus(WidgetRef ref) {
    final useUnified = ref.watch(useUnifiedTimerProvider);
    
    if (useUnified) {
      final status = ref.watch(timerStatusProvider);
      return _convertToLegacyStatus(status);
    } else {
      return ref.watch(currentTimerProvider.select((timer) => timer?.status));
    }
  }
  
  /// Start timer (uses active system)
  static Future<void> startTimer(
    WidgetRef ref, {
    required int durationSeconds,
    legacy.TimerType? type,
    String? exerciseName,
    int? currentSet,
    int? totalSets,
    String? workoutId,
    String? customSound,
  }) async {
    final useUnified = ref.read(useUnifiedTimerProvider);
    
    try {
      if (useUnified) {
        await ref.read(unifiedTimerProvider.notifier).startTimer(
          durationSeconds: durationSeconds,
          type: _convertToUnifiedType(type ?? legacy.TimerType.rest),
          exerciseName: exerciseName,
          currentSet: currentSet,
          totalSets: totalSets,
          workoutId: workoutId,
          customSound: customSound,
        );
      } else {
        await ref.read(currentTimerProvider.notifier).startTimer(
          durationSeconds: durationSeconds,
          type: type ?? legacy.TimerType.rest,
          exerciseName: exerciseName,
          currentSet: currentSet,
          totalSets: totalSets,
          workoutId: workoutId,
        );
      }
      
      DebugLogger.log(LogCategory.timer, 
        '$_debugPrefix: Timer started via ${useUnified ? 'Unified' : 'Legacy'} system');
        
    } catch (e) {
      DebugLogger.log(LogCategory.timer, '$_debugPrefix: Timer start error: $e');
      rethrow;
    }
  }
  
  /// Pause timer (uses active system)
  static Future<void> pauseTimer(WidgetRef ref) async {
    final useUnified = ref.read(useUnifiedTimerProvider);
    
    try {
      if (useUnified) {
        await ref.read(unifiedTimerProvider.notifier).pauseTimer();
      } else {
        await ref.read(currentTimerProvider.notifier).pauseTimer();
      }
    } catch (e) {
      DebugLogger.log(LogCategory.timer, '$_debugPrefix: Timer pause error: $e');
      rethrow;
    }
  }
  
  /// Resume timer (uses active system)
  static Future<void> resumeTimer(WidgetRef ref) async {
    final useUnified = ref.read(useUnifiedTimerProvider);
    
    try {
      if (useUnified) {
        await ref.read(unifiedTimerProvider.notifier).resumeTimer();
      } else {
        await ref.read(currentTimerProvider.notifier).resumeTimer();
      }
    } catch (e) {
      DebugLogger.log(LogCategory.timer, '$_debugPrefix: Timer resume error: $e');
      rethrow;
    }
  }
  
  /// Stop timer (uses active system)
  static Future<void> stopTimer(WidgetRef ref) async {
    final useUnified = ref.read(useUnifiedTimerProvider);
    
    try {
      if (useUnified) {
        await ref.read(unifiedTimerProvider.notifier).stopTimer();
      } else {
        await ref.read(currentTimerProvider.notifier).stopTimer();
      }
    } catch (e) {
      DebugLogger.log(LogCategory.timer, '$_debugPrefix: Timer stop error: $e');
      rethrow;
    }
  }
  
  /// Reset timer (uses active system)
  static Future<void> resetTimer(WidgetRef ref) async {
    final useUnified = ref.read(useUnifiedTimerProvider);
    
    try {
      if (useUnified) {
        await ref.read(unifiedTimerProvider.notifier).resetTimer();
      } else {
        await ref.read(currentTimerProvider.notifier).resetTimer();
      }
    } catch (e) {
      DebugLogger.log(LogCategory.timer, '$_debugPrefix: Timer reset error: $e');
      rethrow;
    }
  }
  
  /// Get system status for debugging
  static Map<String, dynamic> getSystemStatus(WidgetRef ref) {
    final useUnified = ref.read(useUnifiedTimerProvider);
    final unifiedState = ref.read(unifiedTimerProvider);
    final legacyState = ref.read(currentTimerProvider);
    
    return {
      'activeSystem': useUnified ? 'unified' : 'legacy',
      'unifiedActive': unifiedState != null,
      'legacyActive': legacyState != null,
      'unifiedStatus': unifiedState?.status.toString(),
      'legacyStatus': legacyState?.status.toString(),
      'featureFlags': ref.read(timerFeatureFlagsProvider).valueOrNull?.getAllFlags(),
    };
  }
  
  // Conversion utilities
  static legacy.RestTimer? _convertFromUnified(unified.UnifiedTimerState? unifiedState) {
    if (unifiedState == null) return null;
    
    return legacy.RestTimer(
      id: unifiedState.id,
      type: _convertToLegacyType(unifiedState.type),
      totalDurationSeconds: unifiedState.totalDurationSeconds,
      remainingSeconds: unifiedState.remainingSeconds,
      status: _convertToLegacyStatus(unifiedState.status),
      startTime: unifiedState.startTime,
      endTime: unifiedState.endTime,
      exerciseName: unifiedState.exerciseName,
      currentSet: unifiedState.currentSet,
      totalSets: unifiedState.totalSets,
      workoutId: unifiedState.workoutId,
      audioAlreadyPlayed: unifiedState.audioPlayed,
      completionTime: unifiedState.completionTime,
    );
  }
  
  static legacy.TimerType _convertToLegacyType(unified.TimerType type) {
    switch (type) {
      case unified.TimerType.rest:
        return legacy.TimerType.rest;
      case unified.TimerType.workout:
        return legacy.TimerType.workout;
      case unified.TimerType.warmup:
        return legacy.TimerType.warmup;
      case unified.TimerType.cooldown:
        return legacy.TimerType.cooldown;
    }
  }
  
  static unified.TimerType _convertToUnifiedType(legacy.TimerType type) {
    switch (type) {
      case legacy.TimerType.rest:
        return unified.TimerType.rest;
      case legacy.TimerType.workout:
        return unified.TimerType.workout;
      case legacy.TimerType.warmup:
        return unified.TimerType.warmup;
      case legacy.TimerType.cooldown:
        return unified.TimerType.cooldown;
    }
  }
  
  static legacy.TimerStatus? _convertToLegacyStatus(unified.TimerStatus? status) {
    if (status == null) return null;
    
    switch (status) {
      case unified.TimerStatus.idle:
        return legacy.TimerStatus.idle;
      case unified.TimerStatus.running:
        return legacy.TimerStatus.running;
      case unified.TimerStatus.paused:
        return legacy.TimerStatus.paused;
      case unified.TimerStatus.completed:
        return legacy.TimerStatus.completed;
    }
  }
}

// Convenience providers using the adapter
final adaptiveCurrentTimerProvider = Provider<legacy.RestTimer?>((ref) {
  return TimerSystemAdapter.getCurrentTimer(ref);
});

final adaptiveTimerActiveProvider = Provider<bool>((ref) {
  return TimerSystemAdapter.getIsTimerActive(ref);
});

final adaptiveTimerRemainingProvider = Provider<int>((ref) {
  return TimerSystemAdapter.getRemainingSeconds(ref);
});

final adaptiveTimerProgressProvider = Provider<double>((ref) {
  return TimerSystemAdapter.getProgress(ref);
});

final adaptiveTimerStatusProvider = Provider<legacy.TimerStatus?>((ref) {
  return TimerSystemAdapter.getTimerStatus(ref);
});

/// Timer System Controller - Provides methods for UI actions
class TimerSystemController {
  final WidgetRef ref;
  
  const TimerSystemController(this.ref);
  
  Future<void> startTimer({
    required int durationSeconds,
    legacy.TimerType? type,
    String? exerciseName,
    int? currentSet,
    int? totalSets,
    String? workoutId,
    String? customSound,
  }) async {
    await TimerSystemAdapter.startTimer(
      ref,
      durationSeconds: durationSeconds,
      type: type,
      exerciseName: exerciseName,
      currentSet: currentSet,
      totalSets: totalSets,
      workoutId: workoutId,
      customSound: customSound,
    );
  }
  
  Future<void> pauseTimer() async {
    await TimerSystemAdapter.pauseTimer(ref);
  }
  
  Future<void> resumeTimer() async {
    await TimerSystemAdapter.resumeTimer(ref);
  }
  
  Future<void> stopTimer() async {
    await TimerSystemAdapter.stopTimer(ref);
  }
  
  Future<void> resetTimer() async {
    await TimerSystemAdapter.resetTimer(ref);
  }
}

/// Provider for timer controller
final timerSystemControllerProvider = Provider<TimerSystemController>((ref) {
  return TimerSystemController(ref);
});