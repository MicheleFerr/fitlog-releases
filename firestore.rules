rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============= HELPER FUNCTIONS =============
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ========================================
    // 🔐 SECURITY: Check admin via custom claims (secure)
    // ========================================
    // REPLACED: email in ['admin@admin.com', 'ferrara-michele@hotmail.it'] (insecure)
    // NEW: Uses Firebase Custom Claims (server-validated, cannot be forged)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ============================================================================
    // 🔐 GDPR-COMPLIANT BODY MEASUREMENTS HELPERS
    // ============================================================================
    // Added: 2025-01-24 (Task 2.2 - GDPR Body Measurements Feature)
    // Purpose: Consent-driven access control for body measurements
    // GDPR Articles: 6 (Legal Basis), 7 (Consent), 25 (Privacy by Design), 32 (Security)
    // ============================================================================

    /// Check if metric type is valid (20+ supported metrics)
    function isValidMetricType(metricType) {
      let validTypes = [
        // Essential (6)
        'weight', 'bodyFatPercentage', 'height', 'leanMass', 'bmi', 'bmr',
        // Measurements (13 circumferences)
        'neckCircumference', 'shoulderCircumference', 'chestCircumference',
        'waistCircumference', 'abdomenCircumference', 'hipCircumference',
        'bicepLeftCircumference', 'bicepRightCircumference',
        'forearmLeftCircumference', 'forearmRightCircumference',
        'thighLeftCircumference', 'thighRightCircumference',
        'calfLeftCircumference', 'calfRightCircumference',
        // Vitals (3)
        'bodyTemperature', 'waterMass', 'boneMass'
      ];
      return metricType in validTypes;
    }

    /// Get metric group for metric type (for consent validation)
    function getMetricGroup(metricType) {
      // Essential group
      let essential = ['weight', 'bodyFatPercentage', 'height', 'leanMass', 'bmi', 'bmr'];
      if (metricType in essential) {
        return 'essential';
      }

      // Vitals group
      let vitals = ['bodyTemperature', 'waterMass', 'boneMass'];
      if (metricType in vitals) {
        return 'vitals';
      }

      // Measurements group (all circumferences)
      return 'measurements';
    }

    /// Check if user has consent for metric (GDPR Article 6 - Legal Basis)
    function hasConsentForMetric(userId, metricType) {
      // Check if consent document exists
      let consentDoc = /databases/$(database)/documents/userConsents/$(userId);

      if (!exists(consentDoc)) {
        return false; // No consent = no access
      }

      // Get metric group (essential, measurements, vitals)
      let metricGroup = getMetricGroup(metricType);

      // Check if consent is granted for this group
      let consent = get(consentDoc).data;

      // groupConsents is a map: { essential: 'granted', measurements: 'notAsked', vitals: 'denied' }
      return consent.groupConsents[metricGroup] == 'granted';
    }

    /// Validate encrypted measurement schema
    function isValidEncryptedMeasurement(data) {
      // Required fields for encrypted measurement
      let requiredFields = ['id', 'userId', 'metricType', 'encryptedData', 'iv', 'tag', 'timestamp'];

      // Check all required fields exist
      let hasAllFields = data.keys().hasAll(requiredFields);

      // Validate field types
      let validTypes = data.id is string
        && data.userId is string
        && data.metricType is string
        && data.encryptedData is string
        && data.iv is string
        && data.tag is string
        && data.timestamp is timestamp;

      // Validate encryption fields are base64 (non-empty strings)
      let validEncryption = data.encryptedData.size() > 0
        && data.iv.size() > 0
        && data.tag.size() > 0;

      // Validate metric type
      let validMetricType = isValidMetricType(data.metricType);

      return hasAllFields && validTypes && validEncryption && validMetricType;
    }

    /// Validate consent schema
    function isValidConsent(data) {
      let requiredFields = ['id', 'userId', 'groupConsents', 'consentVersion', 'acceptedAt', 'ipAddress'];

      let hasAllFields = data.keys().hasAll(requiredFields);

      // groupConsents must be a map with 3 keys
      let validGroupConsents = data.groupConsents is map
        && data.groupConsents.keys().hasAll(['essential', 'measurements', 'vitals']);

      // Each consent state must be 'notAsked', 'granted', or 'denied'
      let validStates = data.groupConsents.essential in ['notAsked', 'granted', 'denied']
        && data.groupConsents.measurements in ['notAsked', 'granted', 'denied']
        && data.groupConsents.vitals in ['notAsked', 'granted', 'denied'];

      // Validate types
      let validTypes = data.id is string
        && data.userId is string
        && data.consentVersion is int
        && data.acceptedAt is timestamp
        && data.ipAddress is string;

      return hasAllFields && validGroupConsents && validStates && validTypes;
    }

    /// Rate limiting: Max 100 measurements per day per user
    function isWithinMeasurementRateLimit(userId) {
      // Get current time
      let now = request.time;

      // Get measurements created in last 24 hours
      // NOTE: This is expensive, only use for write operations
      // In production, use Firebase Functions to track rate limits
      return true; // Placeholder - implement server-side rate limiting
    }

    /// Rate limiting: Max 10 consent changes per day per user
    function isWithinConsentRateLimit(userId) {
      // Prevent consent spam/abuse
      return true; // Placeholder - implement server-side rate limiting
    }

    // ============= ESERCIZI - LETTURA PUBBLICA, SCRITTURA AUTENTICATA =============
    match /exercises/{exerciseId} {
      allow read: if true; // Tutti possono leggere gli esercizi
      allow write: if request.auth != null; // Solo utenti autenticati possono scrivere
    }

    // ============= USER EXERCISE PREFERENCES =============
    // Task 2.3: Exercise favorites and preferences (single document per user)
    match /userExercisePreferences/{userId} {
      // Only the owner can read their preferences
      allow read: if isOwner(userId);

      // Only the owner can create/update their preferences
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['favorites', 'lastUpdated'])
        && request.resource.data.favorites is list;

      // Only the owner can delete their preferences
      allow delete: if isOwner(userId);
    }

    // ============= COMMUNITY CONTRIBUTIONS =============
    match /community_contributions/{contributionId} {
      // Tutti possono leggere (per mostrare contributi pubblici)
      allow read: if true;
      
      // Creazione con validazione
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      
      // Update per votazioni e status
      allow update: if isAuthenticated() && (
        // Il proprietario può modificare
        isOwner(resource.data.userId) ||
        // Altri possono solo votare o il sistema può aggiornare status
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotedBy', 'downvotedBy', 'upvotes', 'downvotes', 'updatedAt', 'status', 'trustScore']))
      );
      
      // Solo il proprietario può eliminare
      allow delete: if isOwner(resource.data.userId);
    }
    
    // ============= USER CONTRIBUTION STATS =============
    match /user_contribution_stats/{userId} {
      // Tutti possono leggere per la classifica
      allow read: if true;
      
      // L'utente può creare/aggiornare le proprie statistiche
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        // Permettiamo aggiornamenti di sistema per stats
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalContributions', 'approvedContributions', 'totalUpvotes', 'totalDownvotes', 'badges', 'lastActivity'])
      );
      
      // Nessuno può eliminare
      allow delete: if false;
    }
    
    // ============= CONTRIBUTION REPORTS =============
    match /contribution_reports/{reportId} {
      // Solo admin possono leggere i report
      // 🔐 SECURITY: Uses isAdmin() helper (custom claims)
      allow read: if isAdmin();
      
      // Tutti gli autenticati possono segnalare
      allow create: if isAuthenticated()
        && request.resource.data.reportedBy == request.auth.uid;
      
      // Nessuno può modificare o eliminare
      allow update, delete: if false;
    }

    // ============= WORKOUT TEMPLATES =============
    match /workout_templates/{templateId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /workoutTemplates/{templateId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // ============= USERS =============
    // ⚠️ REMOVED 2025-01-18 (Task 2.2): Duplicate overly-permissive rule
    // Proper field-validated rule exists at line ~421 with completedMin protection
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }

    // ============= WORKOUTS =============
    // ⚠️ REMOVED 2025-01-18 (Task 2.2): Duplicate overly-permissive rule
    // Proper rule exists at line ~782 with separate read/create/update/delete + email backward compat
    // match /workouts/{workoutId} {
    //   allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    // }

    // ============= COMMUNITY REPORTS SYSTEM ================
    match /exercise_reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasAll(['exerciseId', 'exerciseName', 'imageUrl', 'reportType', 'userId', 'timestamp',
'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.reportType in ['wrong_image', 'missing_image', 'wrong_name'];
      allow update: if request.auth != null
        && request.auth.uid != null
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          || (isAdmin()  // 🔐 SECURITY: Uses custom claims (secure)
              && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        );

      match /suggestions/{suggestionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.userId
          && request.resource.data.keys().hasAll(['reportId', 'userId', 'userName', 'suggestedValue', 'votes', 'voters',
'timestamp'])
          && request.resource.data.votes == 0
          && request.resource.data.voters.size() == 0;
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'voters']);
      }
    }

    // ============= COACH DELEGATIONS =============
    match /coach_delegations/{delegationId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.coachEmail == request.auth.token.email);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.coachEmail == request.auth.token.email);
    }

    // ============= COACH NOTIFICATIONS =============
    match /coachNotifications/{notificationId} {
      // Il coach può leggere le proprie notifiche usando l'email
      allow read: if request.auth != null && 
        request.auth.token.email == resource.data.coachEmail;
      
      // Permettere list/query per le proprie notifiche
      allow list: if request.auth != null && 
        request.auth.token.email != null;
      
      // Qualsiasi utente autenticato può creare notifiche
      allow create: if request.auth != null;
      
      // Solo il coach destinatario può aggiornare (per marcare come letta)
      allow update: if request.auth != null && 
        request.auth.token.email == resource.data.coachEmail;
      
      // Solo il coach può eliminare le proprie notifiche
      allow delete: if request.auth != null && 
        request.auth.token.email == resource.data.coachEmail;
    }

    // ============= ATHLETE NOTIFICATIONS =============
    match /athleteNotifications/{notificationId} {
      // L'atleta può leggere le proprie notifiche usando l'email
      allow read: if request.auth != null && 
        request.auth.token.email == resource.data.athleteEmail;
      
      // Permettere list/query per le proprie notifiche
      allow list: if request.auth != null && 
        request.auth.token.email != null;
      
      // Qualsiasi utente autenticato può creare notifiche
      allow create: if request.auth != null;
      
      // Solo l'atleta destinatario può aggiornare (per marcare come letta)
      allow update: if request.auth != null && 
        request.auth.token.email == resource.data.athleteEmail;
      
      // Solo l'atleta può eliminare le proprie notifiche
      allow delete: if request.auth != null && 
        request.auth.token.email == resource.data.athleteEmail;
    }

    // ============= WORKOUT TEMPLATES =============
    match /workoutTemplates/{templateId} {
      // Il coach può leggere i propri template o quelli pubblici
      allow read: if request.auth != null && 
        (resource.data.coachId == request.auth.uid || 
         resource.data.isPublic == true);
      
      // Solo il coach proprietario può creare template
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.coachId;
      
      // Solo il coach proprietario può aggiornare
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.coachId;
      
      // Solo il coach proprietario può eliminare
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.coachId;
    }

    // ============= TEMPLATE ASSIGNMENTS =============
    match /templateAssignments/{assignmentId} {
      // Coach e atleta possono leggere
      allow read: if request.auth != null && 
        (resource.data.coachId == request.auth.uid || 
         resource.data.athleteId == request.auth.uid);
      
      // Solo il coach può creare assegnazioni
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.coachId;
      
      // Solo il coach può aggiornare
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.coachId;
      
      // Coach o atleta possono eliminare
      allow delete: if request.auth != null && 
        (resource.data.coachId == request.auth.uid || 
         resource.data.athleteId == request.auth.uid);
    }

    // ============= SESSION WORKOUTS - FIXED =============
    match /sessionWorkouts/{workoutId} {
      // Permetti list/query basate su email o userId
      allow list: if request.auth != null;
      
      allow read: if request.auth != null && (
        // Proprietario - AGGIUNTO IL CHECK SULL'EMAIL
        request.auth.token.email == resource.data.email ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid ||
        // Coach con delega - supporta sia userId che email
        (request.auth.token.email != null && (
          // Check con userId
          (resource.data.userId != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.userId)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.userId)).data.permissions.canViewDashboard == true) ||
          // Check con email dell'utente cercando nel documento settings
          (resource.data.userId != null &&
           exists(/databases/$(database)/documents/settings/$(resource.data.userId)) &&
           get(/databases/$(database)/documents/settings/$(resource.data.userId)).data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(resource.data.userId)).data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(resource.data.userId)).data.email)).data.permissions.canViewDashboard == true)
        ))
      );
      
      allow create: if request.auth != null && 
        (request.auth.token.email == request.resource.data.email ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.uid);
         
      allow update, delete: if request.auth != null && 
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.uid);
    }

    // ============= DROP SET ACTIVITY - MODIFICATO PER PERMETTERE UPDATE =============
    match /dropSetActivity/{activityId} {
      // Permetti list/query per utenti autenticati
      allow list: if request.auth != null;
      
      allow read: if request.auth != null && (
        // Proprietario
        request.auth.token.email == resource.data.email ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid ||
        // Coach con delega
        (request.auth.token.email != null &&
         resource.data.email != null &&
         exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)) &&
         get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)).data.permissions.canViewDashboard == true)
      );

      allow create: if request.auth != null && 
        (request.auth.token.email == request.resource.data.email ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.uid);
      
      // MODIFICATO: ora permette update
      allow update: if request.auth != null && 
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.uid ||
         request.auth.uid == resource.data.userId);
      
      allow delete: if request.auth != null && 
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.uid ||
         request.auth.uid == resource.data.userId);
    }

    // ============= SUPERSET ACTIVITY =============
    match /supersetActivity/{activityId} {
      // Permetti list/query per utenti autenticati
      allow list: if request.auth != null;
      
      allow read: if request.auth != null && (
        // Proprietario
        request.auth.token.email == resource.data.email ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid ||
        // Coach con delega
        (request.auth.token.email != null &&
         resource.data.email != null &&
         exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)) &&
         get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)).data.permissions.canViewDashboard == true)
      );

      allow create: if request.auth != null && 
        (request.auth.token.email == request.resource.data.email ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.uid);
      allow update, delete: if request.auth != null && 
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.uid ||
         request.auth.uid == resource.data.userId);
    }

    // ============= REST PAUSE ACTIVITY - MODIFICATO PER PERMETTERE UPDATE =============
    match /restPauseActivity/{activityId} {
      // Permetti list/query per utenti autenticati
      allow list: if request.auth != null;
      
      allow read: if request.auth != null && (
        // Proprietario
        request.auth.token.email == resource.data.email ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid ||
        // Coach con delega
        (request.auth.token.email != null &&
         resource.data.email != null &&
         exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)) &&
         get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)).data.permissions.canViewDashboard == true)
      );

      allow create: if request.auth != null && 
        (request.auth.token.email == request.resource.data.email ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.uid);
      
      // MODIFICATO: ora permette update
      allow update: if request.auth != null && 
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.uid ||
         request.auth.uid == resource.data.userId);
      
      allow delete: if request.auth != null && 
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.uid ||
         request.auth.uid == resource.data.userId);
    }

    // ============= USER MASSIMALI =============
    match /userMassimali/{userId} {
      allow read: if request.auth != null && (
        // Proprietario
        request.auth.uid == userId ||
        // Coach con delega - cerca l'email dell'utente nel documento settings
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/settings/$(userId)) &&
         get(/databases/$(database)/documents/settings/$(userId)).data.email != null &&
         exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)) &&
         get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)).data.permissions.canViewDashboard == true)
      );

      allow write: if request.auth != null && request.auth.uid == userId;

      // Sottocollezione exercises
      match /exercises/{exerciseId} {
        allow read: if request.auth != null && (
          // Proprietario
          request.auth.uid == userId ||
          // Coach con delega
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/settings/$(userId)) &&
           get(/databases/$(database)/documents/settings/$(userId)).data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)).data.permissions.canViewDashboard == true)
        );

        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // ============= SCHEDE (WORKOUT PLANS) =============
    match /schede/{schedaId} {
      allow read: if request.auth != null && (
        request.auth.token.email == resource.data.utente ||
        request.auth.uid == resource.data.userId ||
        (request.auth.token.email != null &&
         resource.data.utente != null &&
         exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.utente)))
      );
      
      allow create: if request.auth != null && 
        (request.auth.token.email == request.resource.data.utente ||
         request.auth.uid == request.resource.data.userId);
      
      allow update: if request.auth != null && (
        request.auth.token.email == resource.data.utente ||
        request.auth.uid == resource.data.userId ||
        (request.auth.token.email != null &&
         resource.data.utente != null &&
         exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.utente)) &&
         get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.utente)).data.permissions.canEditWorkout == true)
      );
      
      allow delete: if request.auth != null && 
        (request.auth.token.email == resource.data.utente ||
         request.auth.uid == resource.data.userId);
    }

    // ============= USERS =============
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!('completedMin' in request.resource.data) ||
            request.resource.data.completedMin >= resource.data.completedMin);
      allow delete: if false;

      // ============= WORKOUTS SUBCOLLECTION (ANALYTICS) =============
      match /workouts/{workoutId} {
        // Users can read/write their own workout history
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ============= ANALYTICS SUBCOLLECTION =============
      match /analytics/{exerciseName} {
        // Users can read/write their own analytics data
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ============= BODY MEASUREMENTS SUBCOLLECTION (DEPRECATED) =============
      // ⚠️ DEPRECATED 2025-01-24: Replaced with GDPR-compliant version
      // Old path: /users/{userId}/bodyMeasurements/{measurementId}
      // New path: /bodyMeasurements/{userId}/measurements/{measurementId} (see bottom of file)
      // Migration: Use ConsentRepository + EncryptionKeyManager for new measurements
      // Legacy data: Keep read-only for backward compatibility
      match /bodyMeasurements/{measurementId} {
        // READ-ONLY for legacy data (no consent enforcement)
        allow read: if request.auth != null && (
          // Proprietario
          request.auth.uid == userId ||
          // Coach con delega
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/settings/$(userId)) &&
           get(/databases/$(database)/documents/settings/$(userId)).data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)).data.permissions.canViewDashboard == true)
        );

        // ⚠️ NEW WRITES BLOCKED - Use /bodyMeasurements/{userId}/measurements/ instead
        allow create, update: if false;

        // DELETE still allowed for cleanup
        allow delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      // ============= PROGRESS PHOTOS SUBCOLLECTION =============
      match /progress-photos/{photoId} {
        allow read: if request.auth != null && (
          // Proprietario
          request.auth.uid == userId ||
          // Coach con delega
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/settings/$(userId)) &&
           get(/databases/$(database)/documents/settings/$(userId)).data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)).data.permissions.canViewDashboard == true)
        );

        allow create: if request.auth != null &&
          request.auth.uid == userId;

        allow update: if request.auth != null &&
          request.auth.uid == userId;

        allow delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      // ============= USER SETTINGS SUBCOLLECTION (NOTIFICATION SETTINGS) =============
      // Path: users/{userId}/settings/notifications
      // Added: 2025-11-25 for notification system v2.0
      match /settings/{settingType} {
        // Users can read/write their own settings (notifications, preferences, etc.)
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ============= SETTINGS =============
    match /settings/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        // Permetti lettura per cercare coach tramite coachCode
        true ||
        (request.auth.token.email != null &&
         resource.data.email != null &&
         exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)))
      );

      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollections
      match /userSettings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ============= NOTIFICATION SETTINGS V2.0 (in settings subcollection) =============
      match /notifications {
        // Users can only read/write their own notification settings
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Validate NotificationSettings v2.0 schema on write
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && validateNotificationSettings(request.resource.data);
      }

      // ============= NOTIFICATION METRICS V2.0 (in settings subcollection) =============
      match /metrics {
        // Users can only read/write their own notification metrics
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /weightHistory/{entryId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/settings/$(userId)) &&
           get(/databases/$(database)/documents/settings/$(userId)).data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)).data.permissions.canViewDashboard == true)
        );
        
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /weightGoalHistory/{entryId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/settings/$(userId)) &&
           get(/databases/$(database)/documents/settings/$(userId)).data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(userId)).data.email)).data.permissions.canViewDashboard == true)
        );
        
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ============= RESTO DELLE REGOLE ESISTENTI =============
    match /userPreferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['showNotes', 'showOptimization', 'showPercentRM']);
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /rpeHistory/{rpeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.keys().hasAll(['userId', 'schedaId', 'exerciseId', 'timestamp']);
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }
    
    match /weeklyCheckIns/{checkInId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.keys().hasAll(['userId', 'schedaId', 'week', 'timestamp']);
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }

    match /cardioSessions/{sessionId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.uid ||
         request.auth.token.email == resource.data.email);

      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.uid ||
            request.auth.token.email == request.resource.data.email)
        && request.resource.data.type in ['walk','run','hiit']
        && request.resource.data.duration is number
        && request.resource.data.mode in ['outdoor','indoor'];

      allow update, delete: if false;
    }
    
    match /programmingState/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['userId', 'currentWeek', 'lastProcessedWeek']);
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /timings/{timingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (request.auth.token.email == request.resource.data.userEmail ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.uid);
      allow update, delete: if false;
    }

    match /esercizi/{esercizioId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && 
        request.auth.token.admin == true;
    }

    // ============= EXERCISE FEEDBACK SYSTEM =============
    match /exerciseFeedback/{feedbackId} {
      // Tutti gli utenti autenticati possono leggere
      allow read: if request.auth != null;
      
      // Creazione con controlli
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.reportedBy.userId &&
        request.resource.data.keys().hasAll(['exerciseId', 'exerciseName', 'feedbackType', 'currentValue', 'proposedValue', 'reportedBy', 'deviceInfo']) &&
        request.resource.data.feedbackType in ['nome', 'immagine', 'focus'];
      
      // Update solo per aggiungere approvazioni
      allow update: if request.auth != null &&
        // Non può approvare le proprie segnalazioni
        request.auth.uid != resource.data.reportedBy.userId &&
        // Solo modifiche al campo approvals e approvalCount
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvals', 'approvalCount', 'firstApprovalAt']) &&
        // L'utente non ha già approvato
        !resource.data.approvals.hasAny([request.auth.uid]);
      
      // Solo admin può eliminare
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ============= USER FEEDBACK STATS =============
    match /userFeedbackStats/{statsId} {
      // L'utente può leggere le proprie statistiche
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      
      // Sistema può creare/aggiornare (gestito dal service)
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      
      // Solo admin può eliminare
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ============= EXERCISES DATABASE =============
    match /exercises/{exerciseId} {
      // Permetti lettura a tutti gli utenti autenticati
      allow read: if request.auth != null;

      // Solo admin può creare, modificare o eliminare
      allow create, update, delete: if request.auth != null &&
        request.auth.token.admin == true;
    }

    // ============= EXERCISE PATCHES (USER CORRECTIONS) =============
    match /exercise_patches/{patchId} {
      // CREATE: Only authenticated users, must match userId
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.keys().hasAll(['exerciseId', 'userId', 'fieldName', 'oldValue', 'newValue', 'originalValue', 'reason', 'status', 'language', 'createdAt', 'expiresAt', 'version'])
        && request.resource.data.reason.size() >= 10;

      // READ: Owner can read own patches, all authenticated users can read (for transparency)
      allow read: if isAuthenticated();

      // UPDATE: Only for status changes (approval/rejection) - admin only
      allow update: if isAuthenticated()
        && request.auth.token.admin == true
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.exerciseId == resource.data.exerciseId
        && request.resource.data.fieldName == resource.data.fieldName;

      // DELETE: Never allow (audit trail preservation)
      allow delete: if false;
    }

    match /attivitaEsercizi/{activityId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId ||
         request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.uid);
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.userId ||
         request.auth.token.email == request.resource.data.email ||
         request.auth.uid == request.resource.data.uid);
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId ||
         request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.uid);
    }

    // ============= WORKOUT FEEDBACK =============
    match /workoutFeedback/{feedbackId} {
      // Permetti list/query a tutti gli utenti autenticati
      // I documenti saranno filtrati dalla query stessa
      allow read: if request.auth != null;
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.athleteId &&
        request.resource.data.keys().hasAll(['athleteId', 'athleteEmail', 'athleteName', 'overallRPE', 'overallDifficulty']);
      
      allow update: if request.auth != null && 
        resource != null &&
        (request.auth.uid == resource.data.athleteId || 
         request.auth.uid == resource.data.coachId);
      
      allow delete: if false; // Non permettiamo eliminazione di feedback
    }

    // ============= OCR USAGE - GLOBAL SETTINGS =============
    match /settings/ocr_usage {
      // Tutti gli utenti autenticati possono leggere per verificare limiti
      allow read: if request.auth != null;
      
      // Solo il sistema può scrivere (tramite Cloud Functions o Admin SDK)
      allow create, update: if request.auth != null;
      
      // Non permettiamo eliminazione
      allow delete: if false;
    }

    // ============= OCR USAGE - USER STATS =============
    match /users/{userId}/ocr_usage/stats {
      // L'utente può leggere le proprie statistiche
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Sistema può creare/aggiornare
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Non permettiamo eliminazione
      allow delete: if false;
    }

    // ============= WORKOUT TEMPLATES =============
    match /workoutTemplates/{templateId} {
      // Il coach proprietario può leggere/scrivere i propri template
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.coachId;
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.coachId &&
        request.resource.data.keys().hasAll(['coachId', 'name', 'giorni', 'createdAt']);
      
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.coachId;
      
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.coachId;
    }

    // ============= COMPLETED WORKOUTS =============
    match /completedWorkouts/{workoutId} {
      allow read: if request.auth != null && (
        // Proprietario
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == resource.data.email ||
        // Coach con delega
        (request.auth.token.email != null && (
          // Check con email dell'utente
          (resource.data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + resource.data.email)).data.permissions.canViewDashboard == true) ||
          // Check con userId cercando email in settings
          (resource.data.userId != null &&
           exists(/databases/$(database)/documents/settings/$(resource.data.userId)) &&
           get(/databases/$(database)/documents/settings/$(resource.data.userId)).data.email != null &&
           exists(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(resource.data.userId)).data.email)) &&
           get(/databases/$(database)/documents/coach_delegations/$(request.auth.token.email + '_' + get(/databases/$(database)/documents/settings/$(resource.data.userId)).data.email)).data.permissions.canViewDashboard == true)
        ))
      );
      
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.userId ||
         request.auth.token.email == request.resource.data.email);
        
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId ||
         request.auth.token.email == resource.data.email);
    }

    // ============= WORKOUTS - MODIFICATO PER SUPPORTARE EMAIL =============
    match /workouts/{workoutId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == resource.data.email  // AGGIUNTO per supportare dati vecchi
      );
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }

    match /workoutHistory/{historyId} {
      allow read: if request.auth != null && 
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.uid);
      allow create: if request.auth != null && 
        (request.auth.token.email == request.resource.data.email ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.uid);
      allow update: if false;
      allow delete: if false;
    }
    // ============= COLLEZIONI LEGACY (con 's') =============
  match /dropSetsActivity/{activityId} {
    allow read: if request.auth != null && (
      request.auth.token.email == resource.data.email ||
      request.auth.uid == resource.data.userId ||
      request.auth.uid == resource.data.uid
    );
    allow write: if false; // Solo lettura per dati legacy
  }

  match /supersetsActivity/{activityId} {
    allow read: if request.auth != null && (
      request.auth.token.email == resource.data.email ||
      request.auth.uid == resource.data.userId ||
      request.auth.uid == resource.data.uid
    );
    allow write: if false; // Solo lettura per dati legacy
  }

    // ============= COMMUNITY PROGRAMS =============
    match /communityPrograms/{programId} {
      // Lettura permessa per tutti gli utenti autenticati
      // I programmi privati saranno filtrati lato client
      allow read: if request.auth != null;
      
      // Creazione solo per utenti autenticati
      allow create: if request.auth != null && 
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorEmail', 'title', 'description', 'category', 'difficulty', 'duration', 'daysPerWeek', 'giorni', 'tags', 'isPublic', 'stats']);
      
      // Update permesso per:
      // 1. L'autore può modificare tutto
      // 2. Altri utenti possono solo modificare stats (per likes, views, downloads)
      allow update: if request.auth != null && (
        // Autore può modificare tutto
        resource.data.authorId == request.auth.uid ||
        // Altri utenti possono solo modificare stats
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'updatedAt']))
      );
      
      // Eliminazione solo per l'autore
      allow delete: if request.auth != null && 
        resource.data.authorId == request.auth.uid;
      
      // ============= PROGRAM REVIEWS (subcollection) =============
      match /reviews/{reviewId} {
        // Lettura permessa per tutti
        allow read: if request.auth != null;
        
        // Creazione solo per utenti che hanno scaricato il programma
        allow create: if request.auth != null && 
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasAll(['userId', 'userName', 'rating', 'review', 'timestamp']);
        
        // Update solo per l'autore della recensione
        allow update: if request.auth != null && 
          resource.data.userId == request.auth.uid;
        
        // Eliminazione solo per l'autore della recensione
        allow delete: if request.auth != null && 
          resource.data.userId == request.auth.uid;
      }
    }
    
    // ============= PROGRAM DOWNLOADS =============
    match /programDownloads/{downloadId} {
      // Gli utenti possono vedere:
      // 1. I propri download (sempre)
      // 2. Download con recensioni (rating > 0) di qualsiasi utente (per mostrare recensioni pubbliche)
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (resource.data.rating != null && resource.data.rating > 0)
      );
      
      // Gli utenti possono creare download per se stessi
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['programId', 'programTitle', 'authorName', 'userId', 'userName', 'downloadedAt', 'appliedToScheda']);
      
      // Gli utenti possono aggiornare i propri download (per recensioni)
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'review', 'reviewedAt', 'appliedToScheda', 'schedaId']);
      
      // Nessuno può eliminare i download (per mantenere le statistiche)
      allow delete: if false;
    }

    // ==========================================
    // NOTIFICATION SETTINGS V2.0 SECURITY RULES
    // ==========================================

    // User notification settings document (4 segments: collection/doc/subcollection/doc)
    // Path: users/{userId}/notificationSettings/settings
    match /users/{userId}/notificationSettings/{settingsId} {

      // Users can only read/write their own notification settings
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Validate NotificationSettings v2.0 schema on write
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validateNotificationSettings(request.resource.data);

      // Allow deletion for GDPR compliance (Article 17: Right to Erasure)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User notification history collection
    match /users/{userId}/notificationHistory/{notificationId} {

      // Users can only read/write their own notification history
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Validate NotificationHistoryEntry schema on write
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validateNotificationHistoryEntry(request.resource.data);

      // Allow deletion for GDPR compliance (Article 17: Right to Erasure)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User notification metrics document (4 segments: collection/doc/subcollection/doc)
    // Path: users/{userId}/notificationMetrics/metrics
    match /users/{userId}/notificationMetrics/{metricsId} {

      // Users can only read/write their own notification metrics
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow deletion for GDPR compliance (Article 17: Right to Erasure)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User notification delivery tracking collection
    match /users/{userId}/notificationDelivery/{deliveryId} {

      // Users can only read/write their own notification delivery records
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow deletion for GDPR compliance (Article 17: Right to Erasure)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // NOTIFICATION V2.0 VALIDATION FUNCTIONS
    // ==========================================

    function validateNotificationSettings(data) {
      return data.keys().hasAll([
        'enableWorkoutReminders',
        'enableRecoveryAlerts',
        'settingsVersion'
      ])
      && data.settingsVersion is int
      && data.settingsVersion >= 2
      && (data.enableWorkoutReminders is bool)
      && (data.enableRecoveryAlerts is bool)
      && (data.enableStreakMotivation is bool)
      && (data.enableRestDayReminders is bool)
      && (data.enableSmartScheduling is bool)
      && (data.doNotDisturbEnabled is bool)
      && (data.reminderMinutesBefore is int)
      && (data.reminderMinutesBefore >= 0 && data.reminderMinutesBefore <= 1440)
      // v2.0 specific validations
      && validateFrequencyCap(data)
      && validateDataRetention(data)
      && validateConsent(data);
    }

    function validateFrequencyCap(data) {
      return !data.keys().hasAny(['frequencyCapPreferences'])
        || (
          data.frequencyCapPreferences.maxPerDay is int
          && data.frequencyCapPreferences.maxPerDay >= 1
          && data.frequencyCapPreferences.maxPerDay <= 10
          && data.frequencyCapPreferences.maxPerWeek is int
          && data.frequencyCapPreferences.maxPerWeek >= 1
          && data.frequencyCapPreferences.maxPerWeek <= 20
          && data.frequencyCapPreferences.minIntervalHours is int
          && data.frequencyCapPreferences.minIntervalHours >= 0
          && data.frequencyCapPreferences.minIntervalHours <= 24
        );
    }

    function validateDataRetention(data) {
      return data.dataRetentionDays is int
        && data.dataRetentionDays >= 30
        && data.dataRetentionDays <= 365;
    }

    function validateConsent(data) {
      // GDPR: If enableAnalytics is true, consentTimestamp must exist
      return !data.enableAnalytics
        || (data.enableAnalytics && data.keys().hasAny(['consentTimestamp']));
    }

    function validateNotificationHistoryEntry(data) {
      return data.keys().hasAll([
        'type',
        'title',
        'body',
        'timestamp',
        'isRead'
      ])
      && data.type is string
      && data.type in ['workout_reminder', 'recovery_alert', 'streak_motivation', 'rest_day_reminder', 'achievement']
      && data.title is string
      && data.body is string
      && data.timestamp is timestamp
      && data.isRead is bool;
    }


    // ==========================================
    // FLEXIBLE ROUTINES (v1.0 - DEPRECATED)
    // ==========================================
    match /flexibleRoutines/{routineId} {
      // Users can read/write their own routines
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;

      // Users can create routines for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // ROUTINES (v2.0 - CURRENT)
    // ==========================================
    match /routines/{routineId} {
      // Helper: Validate required fields on create
      function isValidRoutineCreate() {
        return request.resource.data.keys().hasAll([
          'id', 'userId', 'name', 'presetType', 'trainingDays',
          'workoutSchedule', 'isActive', 'completedDays', 'totalWorkouts',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.presetType in ['ppl_6_day', 'upper_lower_4_day', 'full_body_3_day', 'bro_split_5_day', 'custom']
        && request.resource.data.trainingDays is list
        && request.resource.data.workoutSchedule is map
        && request.resource.data.isActive is bool
        && request.resource.data.completedDays is list
        && request.resource.data.totalWorkouts is int
        && request.resource.data.totalWorkouts >= 0;
      }

      // Helper: Validate required fields on update
      function isValidRoutineUpdate() {
        return request.resource.data.userId == resource.data.userId  // userId cannot change
        && request.resource.data.id == resource.data.id;  // id cannot change
      }

      // READ: Users can only read their own routines
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // CREATE: Users can create routines for themselves with validation
      // Automatically deactivates all other routines (handled by repository)
      allow create: if isAuthenticated()
        && isOwner(request.resource.data.userId)
        && isValidRoutineCreate();

      // UPDATE: Users can only update their own routines
      // userId and id fields are immutable
      allow update: if isAuthenticated()
        && isOwner(resource.data.userId)
        && isValidRoutineUpdate();

      // DELETE: Users can only delete their own routines
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ==========================================
    // ROUTINE BACKUPS (v1.0 → v2.0 Migration)
    // ==========================================
    match /routine_backups_v1/{routineId} {
      // READ: Users can read their own backups
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // CREATE: Only system/migration service can create backups
      allow create: if isAuthenticated();

      // UPDATE: Not allowed (backups are immutable)
      allow update: if false;

      // DELETE: Users can delete their own backups after successful rollback
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ==========================================
    // EXERCISES METADATA (VERSION INFO)
    // ==========================================
    match /exercises_metadata/version_info {
      // Everyone can read version info (for update checks)
      allow read: if true;
      
      // Only authenticated users can write (admin/system)
      allow write: if request.auth != null;
    }

    // ==========================================
    // INSIGHT FEEDBACK
    // ==========================================
    match /insight_feedback/{feedbackId} {
      // Users can read their own feedback
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Users can create feedback for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Users can update their own feedback
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // ⚠️ ADDED 2025-01-18: SECURITY RULES FOR PREVIOUSLY UNPROTECTED COLLECTIONS
    // ==========================================

    // ============= USER SUBCOLLECTIONS (HIGH PRIORITY - SENSITIVE DATA) =============

    // PR Celebrations - Personal records celebrations
    match /users/{userId}/pr_celebrations/{celebrationId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Recovery History - Recovery tracking data
    match /users/{userId}/recovery_history/{historyId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // HRV Readings - Heart Rate Variability health data
    match /users/{userId}/hrv_readings/{readingId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // ============= TOP-LEVEL COLLECTIONS WITH USERID (HIGH PRIORITY) =============

    // Achievements - AI Coach achievements
    match /achievements/{achievementId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Workout Metrics - Aggregated workout statistics
    match /workoutMetrics/{metricId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============= BUDDY MATCHING SYSTEM (MEDIUM PRIORITY) =============

    // Buddy Profiles - User profiles for buddy matching
    match /buddy_profiles/{profileId} {
      // Users can read all profiles (for matching)
      allow read: if isAuthenticated();

      // Users can only create/update their own profile
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Buddy Matches - Matched buddy pairs
    match /buddy_matches/{matchId} {
      // Users can read matches they're part of
      allow read: if isAuthenticated() && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );

      // System creates matches (both users must exist)
      allow create: if isAuthenticated();

      // Users can update matches they're part of (for status changes)
      allow update: if isAuthenticated() && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );

      // Users can delete matches they're part of
      allow delete: if isAuthenticated() && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
    }

    // Buddy Actions - Actions/interactions between buddies
    match /buddy_actions/{actionId} {
      // Users can read actions involving them
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid
      );

      // Users can create actions for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // No updates/deletes (audit trail)
      allow update, delete: if false;
    }

    // Buddy Reports - Reports of inappropriate behavior
    match /buddy_reports/{reportId} {
      // Only reporters and system can read reports
      allow read: if isAuthenticated() && resource.data.reporterId == request.auth.uid;

      // Users can create reports
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;

      // No updates/deletes after creation (integrity)
      allow update, delete: if false;
    }

    // Workouts Together - Shared workout sessions
    match /workouts_together/{workoutId} {
      // Users can read workouts they're part of
      allow read: if isAuthenticated() && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );

      // Users can create workouts they're part of
      allow create: if isAuthenticated() && (
        request.resource.data.userId1 == request.auth.uid ||
        request.resource.data.userId2 == request.auth.uid
      );

      // Users can update workouts they're part of
      allow update: if isAuthenticated() && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );

      // Users can delete workouts they're part of
      allow delete: if isAuthenticated() && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
    }

    // ============= COMMUNITY FEATURES (MEDIUM PRIORITY) =============

    // User Saved Contributions - Saved community contributions
    match /user_saved_contributions/{savedId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Contribution Reports - Reports of inappropriate contributions
    match /contribution_reports/{reportId} {
      // Only reporters can read their own reports
      allow read: if isAuthenticated() && resource.data.reporterId == request.auth.uid;

      // Users can create reports
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;

      // No updates/deletes after creation (integrity)
      allow update, delete: if false;
    }

    // ============= SEARCH & FILTERS (MEDIUM PRIORITY) =============

    // User Search Filters - Saved search preferences
    match /user_search_filters/{filterId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ============= VERIFICATION SYSTEM (MEDIUM PRIORITY) =============

    // Verification Requests - Identity verification requests
    match /verification_requests/{requestId} {
      // Users can read their own requests
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Users can create verification requests for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // No updates/deletes (system handles state)
      allow update, delete: if false;
    }

    // Photo Verification Requests - Photo verification for profiles
    match /photo_verification_requests/{requestId} {
      // Users can read their own requests
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Users can create photo verification requests for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // No updates/deletes (system handles state)
      allow update, delete: if false;
    }

    // ============= TEMPLATE SYSTEM (MEDIUM PRIORITY) =============

    // Template Reviews - Reviews of workout templates
    match /template_reviews/{reviewId} {
      // Everyone can read reviews (public)
      allow read: if isAuthenticated();

      // Users can create reviews for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Users can update their own reviews
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Users can delete their own reviews
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Template Comments - Comments on workout templates
    match /template_comments/{commentId} {
      // Everyone can read comments (public)
      allow read: if isAuthenticated();

      // Users can create comments for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Users can update their own comments
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Users can delete their own comments
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============= PUBLIC DATA (LOW PRIORITY) =============

    // Italian Cities - Public list of Italian cities (for location selection)
    match /italian_cities/{cityId} {
      // Everyone can read (public data)
      allow read: if true;

      // Only system/admin can write
      allow write: if isAuthenticated();
    }

    // Ice Breakers - Public ice breaker questions for chat
    match /ice_breakers/{iceBreakerId} {
      // Everyone can read (public data)
      allow read: if isAuthenticated();

      // Users can update usage stats
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed', 'lastUsed']);

      // Only system/admin can create/delete
      allow create, delete: if isAuthenticated();
    }

    // ==========================================
    // ⚠️ ADDED 2025-01-18 (Phase 2 - Task 2.1): ADDITIONAL MISSING COLLECTIONS
    // ==========================================

    // Routine Pauses - User routine pause/resume tracking
    match /routine_pauses/{pauseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User Feedback - User feedback submissions
    match /userFeedback/{feedbackId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Exercise Feedback - User feedback for exercises (admin access too)
    match /exercise_feedback/{feedbackId} {
      // Users can read their own feedback, admins can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Users can create feedback for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Users can update their own feedback
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Only users can delete their own feedback
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Analytics Page Feedback - User feedback on analytics page
    match /analytics_page_feedback/{feedbackId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Muscle Group Feedback - User corrections for exercise muscle groups (admin access too)
    match /muscle_group_feedback/{feedbackId} {
      // Users can read their own feedback, admins can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Users can create feedback for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Users can update their own feedback
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Only users can delete their own feedback
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============= UNIFIED FEEDBACK SYSTEM =============
    // Replaces: exercise_feedback, userFeedback, analytics_page_feedback, buddy_reports, ai_coach_feedback
    // Architecture: Type discriminator pattern with metadata for type-specific data
    match /feedback/{feedbackId} {

      // Helper functions for feedback validation
      function isValidFeedbackType() {
        return request.resource.data.type in [
          'exercise', 'ai_insight', 'analytics', 'buddy_report', 'general', 'exercise_patch'
        ];
      }

      function isValidFeedbackStatus() {
        return request.resource.data.status in [
          'open', 'reviewing', 'resolved', 'dismissed', 'closed'
        ];
      }

      function isValidFeedbackSeverity() {
        return request.resource.data.severity in [
          'low', 'medium', 'high', 'critical'
        ];
      }

      function hasRequiredFields() {
        return request.resource.data.keys().hasAll([
          'id', 'userId', 'type', 'status', 'severity', 'message', 'createdAt', 'metadata'
        ]);
      }

      function isValidUserCreate() {
        return isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'open'
          && hasRequiredFields()
          && isValidFeedbackType()
          && isValidFeedbackStatus()
          && isValidFeedbackSeverity()
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.metadata is map;
      }

      function isValidAdminUpdate() {
        // Admin can only update: status, severity, adminNotes, resolvedAt, updatedAt
        let allowedFields = ['status', 'severity', 'adminNotes', 'resolvedAt', 'updatedAt'];
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();

        return isAdmin()
          && changedFields.hasOnly(allowedFields)
          && isValidFeedbackStatus()
          && isValidFeedbackSeverity();
      }

      // READ: Users can read their own feedback, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // CREATE: Users can submit feedback (status must be 'open')
      allow create: if isValidUserCreate();

      // UPDATE: Only admins can update (status, severity, adminNotes)
      // Users CANNOT update their own feedback (immutable for audit trail)
      allow update: if isValidAdminUpdate();

      // DELETE: Not allowed for anyone (audit trail preservation)
      // Soft delete via status='closed' instead
      allow delete: if false;
    }

    // ============================================================================
    // 🔐 GDPR-COMPLIANT BODY MEASUREMENTS FEATURE (v2.0)
    // ============================================================================
    // Added: 2025-01-24 (Task 2.2 - GDPR Body Measurements Implementation)
    //
    // **Privacy by Design (GDPR Article 25)**:
    // - All measurements encrypted with AES-256-GCM (client-side)
    // - Consent-driven access control (3 metric groups: Essential, Measurements, Vitals)
    // - User isolation (userId-based access)
    // - Audit trail for all operations (GDPR Article 30)
    // - Data minimization (only consented metrics stored)
    //
    // **Collections**:
    // 1. /userConsents/{userId} - Consent records (GDPR Article 7)
    // 2. /bodyMeasurements/{userId}/measurements/{measurementId} - Encrypted measurements
    // 3. /auditLogs/{userId}/logs/{logId} - Audit trail (GDPR Article 30)
    // 4. /encryptionMetadata/{userId} - Key rotation tracking
    //
    // **Security Principles**:
    // - Defense in Depth: Multiple validation layers
    // - Fail Secure: Deny by default, explicit allow
    // - GDPR Enforcement: Consent checks BEFORE data access
    // - Rate Limiting: Prevent abuse (100 measurements/day, 10 consents/day)
    //
    // ============================================================================

    // ========== USER CONSENTS (GDPR Article 7 - Conditions for Consent) ==========
    match /userConsents/{userId} {
      // READ: Only the user can read their own consent
      allow read: if isOwner(userId);

      // CREATE: User can create their own consent (initial onboarding)
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && isValidConsent(request.resource.data)
        && isWithinConsentRateLimit(userId)
        && request.resource.data.consentVersion == 1; // Current version

      // UPDATE: User can update their own consent (grant/revoke)
      allow update: if isOwner(userId)
        && resource.data.userId == userId
        && isValidConsent(request.resource.data)
        && isWithinConsentRateLimit(userId)
        && request.resource.data.userId == resource.data.userId // Cannot change userId
        && request.resource.data.consentVersion == resource.data.consentVersion; // Cannot change version

      // DELETE: Not allowed (GDPR audit trail requirement)
      // Consent can be revoked via update (set state to 'denied')
      allow delete: if false;
    }

    // ========== ENCRYPTED MEASUREMENTS (GDPR Article 32 - Security of Processing) ==========
    match /bodyMeasurements/{userId}/measurements/{measurementId} {
      // READ: User can read their own measurements (with consent check)
      allow read: if isOwner(userId)
        && hasConsentForMetric(userId, resource.data.metricType);

      // LIST: User can list their own measurements
      allow list: if isOwner(userId);
      // NOTE: List does NOT check consent per-metric (performance)
      // App should filter results based on consent client-side

      // CREATE: User can create measurement (with consent validation)
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && isValidEncryptedMeasurement(request.resource.data)
        && hasConsentForMetric(userId, request.resource.data.metricType)
        && isWithinMeasurementRateLimit(userId)
        && request.resource.data.id == measurementId; // ID must match document ID

      // UPDATE: User can update their own measurement
      allow update: if isOwner(userId)
        && resource.data.userId == userId
        && isValidEncryptedMeasurement(request.resource.data)
        && hasConsentForMetric(userId, request.resource.data.metricType)
        && request.resource.data.userId == resource.data.userId // Cannot change userId
        && request.resource.data.metricType == resource.data.metricType // Cannot change metric type
        && request.resource.data.id == resource.data.id; // Cannot change ID

      // DELETE: User can delete their own measurement (GDPR Article 17 - Right to Erasure)
      allow delete: if isOwner(userId)
        && resource.data.userId == userId;
    }

    // ========== AUDIT LOGS (GDPR Article 30 - Records of Processing Activities) ==========
    match /auditLogs/{userId}/logs/{logId} {
      // READ: User can read their own audit logs
      allow read: if isOwner(userId);

      // LIST: User can list their own audit logs
      allow list: if isOwner(userId);

      // CREATE: User can create audit logs (app writes on data operations)
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.id == logId;

      // UPDATE: Not allowed (audit logs are immutable)
      allow update: if false;

      // DELETE: Not allowed (GDPR audit trail requirement)
      // Logs retained for 2 years, then auto-deleted via Firebase Functions
      allow delete: if false;
    }

    // ========== ENCRYPTION METADATA (Key Rotation Tracking) ==========
    match /encryptionMetadata/{userId} {
      // READ: User can read their own encryption metadata
      allow read: if isOwner(userId);

      // CREATE: User can create encryption metadata (initial key generation)
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId;

      // UPDATE: User can update encryption metadata (key rotation)
      allow update: if isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId;

      // DELETE: Not allowed (preserve key rotation history)
      allow delete: if false;
    }

  }
}
