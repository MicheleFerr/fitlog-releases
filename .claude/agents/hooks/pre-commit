#!/bin/bash

# 🔄 Pre-commit Hook - Manutenzione automatica prima del commit

echo "🤖 Pre-commit maintenance in corso..."

# Colori per output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Ottieni file modificati
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$CHANGED_FILES" ]; then
    echo "📭 Nessun file da controllare"
    exit 0
fi

ERRORS=0
WARNINGS=0

# Processa ogni file
for file in $CHANGED_FILES; do
    case "$file" in
        lib/*.dart)
            echo -e "${YELLOW}🔧 Checking test for $file${NC}"
            
            # Controlla se esiste il test
            TEST_FILE="${file/lib/test}"
            TEST_FILE="${TEST_FILE/.dart/_test.dart}"
            
            if [ ! -f "$TEST_FILE" ]; then
                echo -e "${RED}❌ Test mancante: $TEST_FILE${NC}"
                WARNINGS=$((WARNINGS + 1))
                
                # Chiedi se creare il test
                read -p "Vuoi generare il test automaticamente? (y/n) " -n 1 -r
                echo
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    bash .claude/agents/scripts/test_maintainer.sh "$file"
                    git add "$TEST_FILE"
                fi
            else
                # Verifica che il test sia aggiornato
                echo "  ✅ Test esistente trovato"
            fi
            
            # Aggiorna KB
            echo -e "${YELLOW}📚 Aggiornando Knowledge Base...${NC}"
            bash .claude/agents/scripts/kb_updater.sh "$file" 2>/dev/null
            ;;
            
        test/*.dart)
            echo -e "${YELLOW}🧪 Running test: $file${NC}"
            flutter test "$file" --no-pub
            if [ $? -ne 0 ]; then
                echo -e "${RED}❌ Test fallito!${NC}"
                ERRORS=$((ERRORS + 1))
            else
                echo -e "${GREEN}✅ Test passato${NC}"
            fi
            ;;
            
        pubspec.yaml)
            echo -e "${YELLOW}📦 Checking dependencies...${NC}"
            flutter pub get
            ;;
    esac
done

# Controlla se ci sono nuove features
COMMIT_MSG=$(cat .git/COMMIT_EDITMSG 2>/dev/null || echo "")
if [[ "$COMMIT_MSG" == *"feat:"* ]] || [[ "$COMMIT_MSG" == *"feature:"* ]]; then
    echo -e "${GREEN}🎉 Nuova feature detectata!${NC}"
    echo "📱 Aggiornamento descrizione app..."
    bash .claude/agents/scripts/app_descriptor.sh 2>/dev/null &
fi

# Esegui linting
echo -e "${YELLOW}🔍 Running Flutter analyze...${NC}"
flutter analyze --no-pub
if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Errori di linting trovati${NC}"
    ERRORS=$((ERRORS + 1))
fi

# Report finale
echo ""
echo "📊 Report Pre-Commit:"
echo "  • File controllati: $(echo "$CHANGED_FILES" | wc -l)"
echo "  • Errori: $ERRORS"
echo "  • Warning: $WARNINGS"

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ Commit bloccato - correggi gli errori${NC}"
    exit 1
fi

if [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}⚠️ Ci sono dei warning${NC}"
    read -p "Vuoi procedere comunque? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

echo -e "${GREEN}✅ Pre-commit check completato con successo!${NC}"
exit 0