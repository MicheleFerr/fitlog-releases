  "strategyReduceFrequencyTitle": "Reduce Training Frequency",
  "strategyReduceFrequencyDesc": "Lower frequency with maintained volume can improve recovery and results",
  "strategyReduceFrequencyHow": "Consolidate workouts into 4-5 quality sessions. Increase volume per session slightly",
  "strategyReduceFrequencyOutcome": "Better recovery, reduced injury risk, maintained or improved gains",
  "strategyImplementRestDaysTitle": "Implement Strategic Rest Days",
  "strategyImplementRestDaysDesc": "Scheduled rest allows adaptation and prevents accumulated fatigue",
  "strategyImplementRestDaysHow": "Take at least 1-2 complete rest days per week. Place them after hardest training days",
  "strategyImplementRestDaysOutcome": "Optimized recovery and sustained performance",
  "dataSession1": "Session 1: {weight}kg",
  "dataSession2": "Session 2: {weight}kg",
  "dataSession3": "Session 3: {weight}kg",
  "dataAverageWeight": "Average: {weight}kg",
  "dataWeightVariation2": "Variation: {weight}kg ({percent}%)",
  "strategyPlateauincreasevolumeTitle": "Increase Training Volume",
  "strategyPlateauincreasevolumeDesc": "Progressive volume increase is one of the primary drivers of hypertrophy adaptation",
  "strategyPlateauincreasevolumeImpl": "Add 1-2 sets per week until you reach 15-20 sets per muscle group. Example: if doing 3 sets, increase to 4-5 sets",
  "strategyPlateauincreasevolumeOutcome": "New growth stimulus within 2-4 weeks. Volume should increase gradually to avoid overtraining",
  "strategyPlateauvaryrepsTitle": "Vary Rep Ranges",
  "strategyPlateauvaryrepsDesc": "Different rep ranges recruit different muscle fiber types and create novel mechanical tension",
  "strategyPlateauvaryrepsImpl": "Alternate between strength (4-6 reps), hypertrophy (8-12 reps), and endurance (15-20 reps) ranges across weeks",
  "strategyPlateauvaryrepsOutcome": "Enhanced overall muscle development and strength gains across all ranges",
  "strategyPlateauadvancedtechniquesTitle": "Implement Advanced Techniques",
  "strategyPlateauadvancedtechniquesDesc": "Intensity techniques increase metabolic stress and mechanical tension beyond traditional sets",
  "strategyPlateauadvancedtechniquesImpl": "Use drop sets (reduce weight 20-30% after failure), rest-pause (10-15 sec rest between mini-sets), or forced reps on final set",
  "strategyPlateauadvancedtechniquesOutcome": "Immediate increase in muscle fiber recruitment and metabolic stress",
  "strategyPlateauchangeexercisesTitle": "Change Exercise Variation",
  "strategyPlateauchangeexercisesDesc": "Novel exercises create different force vectors and recruitment patterns",
  "strategyPlateauchangeexercisesImpl": "Substitute similar exercises with different angles. Example: flat bench → incline bench, squat → front squat",
  "strategyPlateauchangeexercisesOutcome": "Renewed strength gains and muscle activation in 1-2 weeks",
  "strategyPlateaudeloadweekTitle": "Deload Week",
  "strategyPlateaudeloadweekDesc": "Strategic recovery allows supercompensation and nervous system recovery",
  "strategyPlateaudeloadweekImpl": "Reduce volume by 40-50% for 1 week (half the sets, same weight). Maintain frequency but reduce total work",
  "strategyPlateaudeloadweekOutcome": "Return stronger after deload with reduced fatigue and improved neuromuscular efficiency",
  "strategyBalanceincreasefrequencyTitle": "Increase Training Frequency",
  "strategyBalanceincreasefrequencyDesc": "Higher frequency provides more opportunities for volume accumulation and skill practice",
  "strategyBalanceincreasefrequencyImpl": "Split current volume across 2-3 sessions per week instead of 1. Example: 10 sets → 5 sets × 2 days",
  "strategyBalanceincreasefrequencyOutcome": "Better recovery between sessions and higher quality sets",
  "strategyBalanceprioritizeweakTitle": "Prioritize Weak Muscle Groups",
  "strategyBalanceprioritizeweakDesc": "Training lagging muscles first when energy is highest maximizes adaptation",
  "strategyBalanceprioritizeweakImpl": "Perform weak muscle exercises at the beginning of your workout when neurologically fresh",
  "strategyBalanceprioritizeweakOutcome": "Improved performance and progressive overload on weak points",
  "strategyBalanceaddisolationTitle": "Add Isolation Work",
  "strategyBalanceaddisolationDesc": "Direct isolation allows targeted volume without systemic fatigue",
  "strategyBalanceaddisolationImpl": "Add 2-3 isolation exercises (12-15 reps) after compound movements for the weak muscle",
  "strategyBalanceaddisolationOutcome": "Increased local volume and muscle-mind connection",
  "strategyRecoveryoptimizesleepTitle": "Optimize Sleep Duration",
  "strategyRecoveryoptimizesleepDesc": "Sleep is the primary recovery mechanism for neuromuscular adaptation",
  "strategyRecoveryoptimizesleepImpl": "Aim for 7-9 hours per night. Prioritize consistent sleep schedule (same bedtime/wake time)",
  "strategyRecoveryoptimizesleepOutcome": "Enhanced muscle protein synthesis and reduced cortisol levels",
  "strategyRecoveryperiodizeTitle": "Periodize Training Stress",
  "strategyRecoveryperiodizeDesc": "Alternating high and low stress weeks prevents chronic fatigue",
  "strategyRecoveryperiodizeImpl": "3 weeks progressive overload → 1 deload week (50% volume reduction)",
  "strategyRecoveryperiodizeOutcome": "Sustained progress without burnout or injury risk",
  "strategyRecoveryactiverecoveryTitle": "Active Recovery Sessions",
  "strategyRecoveryactiverecoveryDesc": "Light activity enhances blood flow and waste removal without adding fatigue",
  "strategyRecoveryactiverecoveryImpl": "Add 20-30 min low-intensity cardio or mobility work on rest days",
  "strategyRecoveryactiverecoveryOutcome": "Faster recovery and reduced muscle soreness",
  "strategyLongrecoveryscheduleTitle": "Establish Consistent Schedule",
  "strategyLongrecoveryscheduleDesc": "Training frequency is more important than individual session quality for long-term progress",
  "strategyLongrecoveryscheduleImpl": "Schedule 3-5 fixed training days per week. Use calendar reminders. Prepare gym bag the night before",
  "strategyLongrecoveryscheduleOutcome": "Improved habit formation and training adherence within 3-4 weeks",
  "strategyLongrecoverymindoseTitle": "Use Minimum Effective Dose",
  "strategyLongrecoverymindoseDesc": "Short, frequent sessions maintain adaptations better than long, infrequent workouts",
  "strategyLongrecoverymindoseImpl": "If time-constrained, do 20-30 min sessions instead of skipping. Focus on compound movements",
  "strategyLongrecoverymindoseOutcome": "Maintained strength and muscle mass with 60% less volume",
  "strategyLowfrequencyminviableTitle": "Start with Minimum Viable Frequency",
  "strategyLowfrequencyminviableDesc": "Even 2 weekly sessions produce 80% of the benefits of higher frequencies for beginners",
  "strategyLowfrequencyminviableImpl": "Schedule 2 full-body sessions per week (e.g., Monday/Thursday). 45-60 min each with 4-5 compound exercises",
  "strategyLowfrequencyminviableOutcome": "Measurable strength gains within 4-6 weeks. Habit formation in 3-4 weeks",
  "strategyLowfrequencytimeefficientTitle": "Use Time-Efficient Protocols",
  "strategyLowfrequencytimeefficientDesc": "Strategic exercise selection maximizes results per minute invested",
  "strategyLowfrequencytimeefficientImpl": "Focus on compound movements: Squat, Bench, Deadlift, Row, Press. 3 sets of 8-12 reps each. Total: 30-40 min",
  "strategyLowfrequencytimeefficientOutcome": "Full-body stimulus with minimal time investment",
  "strategyHighfrequencyconsolidateTitle": "Consolidate Training Sessions",
  "strategyHighfrequencyconsolidateDesc": "Fewer, higher-quality sessions often outperform high-frequency, lower-quality work",
  "strategyHighfrequencyconsolidateImpl": "Combine similar muscle groups. Example: Instead of 7 separate sessions, do 4-5 focused sessions with more volume per workout",
  "strategyHighfrequencyconsolidateOutcome": "Better recovery, maintained volume, reduced fatigue accumulation",
  "strategyHighfrequencyrestdaysTitle": "Implement Strategic Rest Days",
  "strategyHighfrequencyrestdaysDesc": "Complete rest or active recovery days are essential for supercompensation",
  "strategyHighfrequencyrestdaysImpl": "Take 1-2 full rest days per week. On rest days, do light walking or mobility work only (no resistance training)",
  "strategyHighfrequencyrestdaysOutcome": "Improved strength rebound and reduced injury risk within 2-3 weeks",
  "strategyHighvolumereducegraduallyTitle": "Reduce Volume Gradually",
  "strategyHighvolumereducegraduallyDesc": "Sudden volume drops can cause detraining. Gradual reduction maintains adaptations while allowing recovery",
  "strategyHighvolumereducegraduallyImpl": "Reduce by 20-30% per week until reaching 15-20 sets. Example: 28 sets → 22 sets → 18 sets over 2 weeks",
  "strategyHighvolumereducegraduallyOutcome": "Restored recovery capacity and improved performance within 2-3 weeks",
  "strategyHighvolumedeloadTitle": "Implement Deload Week",
  "strategyHighvolumedeloadDesc": "Strategic recovery week allows supercompensation and fatigue dissipation",
  "strategyHighvolumedeloadImpl": "Cut volume by 50% for one week. Maintain weight but do half the sets. Then resume at optimal volume (15-20 sets)",
  "strategyHighvolumedeloadOutcome": "Return stronger with reduced accumulated fatigue. Strength rebound in 7-10 days",
  "strategyHighvolumeincreasefreqTitle": "Increase Training Frequency",
  "strategyHighvolumeincreasefreqDesc": "Same volume spread across more sessions reduces per-session fatigue",
  "strategyHighvolumeincreasefreqImpl": "Split current volume across more days. Example: 28 sets/week → 7 sets × 4 days instead of 14 sets × 2 days",
  "strategyHighvolumeincreasefreqOutcome": "Better recovery between sessions and higher quality sets",
