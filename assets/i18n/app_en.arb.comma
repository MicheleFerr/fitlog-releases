  "keyFindings": "Key Findings",
  "@keyFindings": {
    "description": "Section title for key findings"
  },
  "repContinuumFinding1": "Strength Zone (1-5 reps): Maximizes neural adaptations and absolute strength. Best for powerlifting and max force production.",
  "@repContinuumFinding1": {
    "description": "Rep continuum finding 1"
  },
  "repContinuumFinding2": "Hypertrophy Zone (6-15 reps): Optimal for muscle growth through mechanical tension and metabolic stress. Industry standard for bodybuilding.",
  "@repContinuumFinding2": {
    "description": "Rep continuum finding 2"
  },
  "repContinuumFinding3": "Endurance Zone (15+ reps): Develops muscular endurance and work capacity. Important for metabolic conditioning.",
  "@repContinuumFinding3": {
    "description": "Rep continuum finding 3"
  },
  "practicalApplication": "Practical Application",
  "@practicalApplication": {
    "description": "Section title for practical advice"
  },
  "repContinuumPracticalAdvice": "For balanced muscle development, aim for 60-70% of your training volume in the hypertrophy zone (6-15 reps). Include 15-20% strength work and 10-15% endurance work for complete adaptation.",
  "@repContinuumPracticalAdvice": {
