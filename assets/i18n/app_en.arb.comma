  "repContinuumScientificSubtitle": "Loading recommendations for muscle strength, hypertrophy, and endurance",
  "@repContinuumScientificSubtitle": {
    "description": "Scientific explanation subtitle"
  },
  "repContinuumPaperSummary": "This comprehensive review analyzed 100+ studies to determine optimal loading strategies. Key finding: different rep ranges produce distinct adaptations - strength (1-5), hypertrophy (6-15), endurance (15+).",
