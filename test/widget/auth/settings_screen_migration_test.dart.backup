/**
 * 🏋️‍♂️ GymBro TrackLog - Flutter Fitness App
 * 
 * 📁 Layer: test/widget
 * 🎯 Feature: auth migration
 * 🔧 Type: widget test
 * 🌍 Localization: ✅ AppLocalizations tested
 * 🎨 Theme: ✅ Both light and dark themes tested
 * 📱 Platform: Universal
 * 
 * CRITICAL WIDGET TESTS for Settings Screen Migration
 * Tests UI behavior with new UserProfile system
 */

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:mocktail/mocktail.dart';
import 'package:gymbro_flutter_new/features/settings/presentation/settings_screen.dart';
import 'package:gymbro_flutter_new/features/auth/presentation/providers/user_provider_v2.dart';
import 'package:gymbro_flutter_new/features/auth/domain/entities/user_profile_consolidated.dart';
import 'package:gymbro_flutter_new/features/auth/domain/entities/user_state.dart';
import 'package:gymbro_flutter_new/shared/presentation/l10n/generated/app_localizations.dart';
import 'package:gymbro_flutter_new/shared/presentation/providers/app_config_provider.dart';
import 'package:gymbro_flutter_new/shared/domain/entities/app_config.dart';
import '../../test_helpers/firebase_test_helper.dart';
import 'package:firebase_core/firebase_core.dart';

class UserProfileFactory {
  static UserProfile createFreeUser({
    String? email,
    String? displayName,
  }) {
    return UserProfile(
      uid: 'test-free-user',
      email: email ?? 'free@gymbro.app',
      displayName: displayName ?? 'Free User',
      accountTier: AccountTier.free,
      templateQuota: TemplateQuota.forTier(AccountTier.free),
      createdAt: DateTime.now(),
      lastLoginAt: DateTime.now(),
      preferences: const UserPreferences(),
      stats: const UserStats(),
    );
  }

  static UserProfile createPremiumUser({
    String? email,
    String? displayName,
  }) {
    return UserProfile(
      uid: 'test-premium-user',
      email: email ?? 'premium@gymbro.app',
      displayName: displayName ?? 'Premium User',
      accountTier: AccountTier.premium,
      templateQuota: TemplateQuota.forTier(AccountTier.premium),
      createdAt: DateTime.now(),
      lastLoginAt: DateTime.now(),
      preferences: const UserPreferences(),
      stats: const UserStats(),
    );
  }
}

// Mocks
class MockUser extends Mock implements User {}
class MockAppConfigNotifier extends Mock implements AppConfigNotifier {}

void main() {
  group('Settings Screen Migration Tests', () {
    late MockUser mockFirebaseUser;
    late MockAppConfigNotifier mockAppConfigNotifier;

    setUpAll(() async {
      setupFirebaseCoreMocks();
      await Firebase.initializeApp();
    });

    setUp(() {
      mockFirebaseUser = MockUser();
      mockAppConfigNotifier = MockAppConfigNotifier();
      
      // Setup default Firebase user
      when(() => mockFirebaseUser.uid).thenReturn('test-user-123');
      when(() => mockFirebaseUser.email).thenReturn('test@gymbro.app');
      when(() => mockFirebaseUser.displayName).thenReturn('Test User');
      when(() => mockFirebaseUser.photoURL).thenReturn(null);
    });

    /// Creates test widget with proper providers and localization
    Widget createTestSettingsScreen({
      UserState? userState,
      ThemeMode themeMode = ThemeMode.light,
      String locale = 'en',
      List<Override> additionalOverrides = const [],
    }) {
      return ProviderScope(
        overrides: [
          userStateProvider.overrideWith((ref) => Stream.value(
            userState ?? UserAuthenticated(UserProfileFactory.createFreeUser())
          )),
          appConfigProvider.overrideWith((ref) {
            final notifier = AppConfigNotifier();
            // Set initial state
            notifier.state = AppConfigPresets.defaultConfig.copyWith(
              themeMode: themeMode,
              languageCode: locale,
            );
            return notifier;
          }),
          ...additionalOverrides,
        ],
        child: MaterialApp(
          theme: ThemeData.light(),
          darkTheme: ThemeData.dark(),
          themeMode: themeMode,
          locale: Locale(locale),
          localizationsDelegates: AppLocalizations.localizationsDelegates,
          supportedLocales: AppLocalizations.supportedLocales,
          home: const SettingsScreen(),
        ),
      );
    }

    group('User Profile Display', () {
      testWidgets('displays free user profile correctly', (tester) async {
        // Arrange
        final freeUser = UserProfileFactory.createFreeUser(
          email: 'free@gymbro.app',
          displayName: 'Free User',
        );
        
        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(freeUser),
        ));
        await tester.pumpAndSettle();

        // Assert: User info section displays correctly
        expect(find.text('Account'), findsOneWidget);
        expect(find.text('Free User'), findsOneWidget);
        expect(find.text('free@gymbro.app'), findsOneWidget);
        
        // Assert: No premium features visible for free users
        expect(find.text('Cloud Sync'), findsNothing);
        expect(find.text('PREMIUM'), findsNothing);
      });

      testWidgets('displays premium user profile with premium features', (tester) async {
        // Arrange
        final premiumUser = UserProfileFactory.createPremiumUser(
          email: 'premium@gymbro.app',
          displayName: 'Premium User',
        );

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(premiumUser),
        ));
        await tester.pumpAndSettle();

        // Assert: Premium user info
        expect(find.text('Premium User'), findsOneWidget);
        expect(find.text('premium@gymbro.app'), findsOneWidget);
        
        // Assert: Premium features visible
        expect(find.text('Cloud Sync'), findsOneWidget);
        expect(find.text('PREMIUM'), findsOneWidget);
        expect(find.byIcon(Icons.cloud_sync), findsOneWidget);
      });

      testWidgets('displays admin user with admin features', (tester) async {
        // Arrange: Admin user (based on email pattern)
        final adminUser = UserProfileFactory.createPremiumUser(
          email: 'michele.cozzolino93@gmail.com', // Admin email
          displayName: 'Michele (Admin)',
        );

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(adminUser),
        ));
        await tester.pumpAndSettle();

        // Assert: Admin badge and features
        expect(find.text('ADMIN'), findsOneWidget);
        expect(find.text('Force Full Cloud Sync'), findsOneWidget);
        expect(find.text('🔧 Admin Tools'), findsOneWidget);
      });

      testWidgets('handles user with photo URL correctly', (tester) async {
        // Arrange: User with photo
        final userWithPhoto = UserProfileFactory.createPremiumUser(
          displayName: 'Photo User',
        ).copyWith(photoURL: 'https://example.com/photo.jpg');

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(userWithPhoto),
        ));
        await tester.pumpAndSettle();

        // Assert: CircleAvatar should have NetworkImage
        final circleAvatar = tester.widget<CircleAvatar>(find.byType(CircleAvatar));
        expect(circleAvatar.backgroundImage, isA<NetworkImage>());
      });
    });

    group('User State Handling', () {
      testWidgets('shows loading state correctly', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: const UserLoading(),
        ));
        await tester.pumpAndSettle();

        // Assert: Loading state displayed
        expect(find.text('Loading'), findsOneWidget);
      });

      testWidgets('shows unauthenticated state correctly', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: const UserUnauthenticated(),
        ));
        await tester.pumpAndSettle();

        // Assert: Not logged in message
        expect(find.text('Not logged in'), findsOneWidget);
      });

      testWidgets('shows error state correctly', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserError('Failed to load user', StackTrace.current),
        ));
        await tester.pumpAndSettle();

        // Assert: Error message displayed
        expect(find.text('Error loading user'), findsOneWidget);
      });

      testWidgets('shows anonymous user state correctly', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: const UserAnonymous(),
        ));
        await tester.pumpAndSettle();

        // Assert: Guest/anonymous state
        expect(find.text('Not logged in'), findsOneWidget);
      });
    });

    group('Localization Testing', () {
      testWidgets('displays English text correctly', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(locale: 'en'));
        await tester.pumpAndSettle();

        // Assert: English text
        expect(find.text('Settings'), findsOneWidget);
        expect(find.text('Account'), findsOneWidget);
        expect(find.text('Appearance'), findsOneWidget);
        expect(find.text('Sign Out'), findsOneWidget);
      });

      testWidgets('displays Italian text correctly', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(locale: 'it'));
        await tester.pumpAndSettle();

        // Assert: Italian text (assuming translations exist)
        expect(find.text('Impostazioni'), findsOneWidget);
        expect(find.text('Account'), findsOneWidget);
        expect(find.text('Aspetto'), findsOneWidget);
        expect(find.text('Disconnetti'), findsOneWidget);
      });
    });

    group('Theme Testing', () {
      testWidgets('displays correctly in light theme', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          themeMode: ThemeMode.light,
        ));
        await tester.pumpAndSettle();

        // Assert: Light theme elements
        final scaffold = tester.widget<Scaffold>(find.byType(Scaffold));
        final appBar = scaffold.appBar as AppBar;
        expect(appBar.backgroundColor, isNotNull);
        
        // Check that cards are rendered (visual elements exist)
        expect(find.byType(Card), findsWidgets);
      });

      testWidgets('displays correctly in dark theme', (tester) async {
        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          themeMode: ThemeMode.dark,
        ));
        await tester.pumpAndSettle();

        // Assert: Dark theme elements
        expect(find.byType(Card), findsWidgets);
        expect(find.byType(AppBar), findsOneWidget);
      });
    });

    group('Premium Features Visibility', () {
      testWidgets('hides cloud sync for free users', (tester) async {
        // Arrange
        final freeUser = UserProfileFactory.createFreeUser();

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(freeUser),
        ));
        await tester.pumpAndSettle();

        // Assert: Cloud sync section not visible
        expect(find.text('Cloud Sync'), findsNothing);
        expect(find.byIcon(Icons.cloud_sync), findsNothing);
      });

      testWidgets('shows cloud sync for premium users', (tester) async {
        // Arrange
        final premiumUser = UserProfileFactory.createPremiumUser();

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(premiumUser),
        ));
        await tester.pumpAndSettle();

        // Assert: Cloud sync section visible
        expect(find.text('Cloud Sync'), findsOneWidget);
        expect(find.byIcon(Icons.cloud_sync), findsOneWidget);
        expect(find.text('Sync from Cloud'), findsOneWidget);
      });

      testWidgets('shows template quota information', (tester) async {
        // Arrange: User with some template usage
        final user = UserProfileFactory.createFreeUser().copyWith(
          templateQuota: TemplateQuota.forTier(
            AccountTier.free,
            usedPrivate: 5,
            usedPublic: 1,
          ),
        );

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(user),
        ));
        await tester.pumpAndSettle();

        // Note: Template quota might be shown in advanced settings
        // This test verifies the settings screen loads without errors
        expect(find.byType(SettingsScreen), findsOneWidget);
      });
    });

    group('Interactive Elements', () {
      testWidgets('sign out button shows confirmation dialog', (tester) async {
        // Arrange
        final user = UserProfileFactory.createFreeUser();

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(user),
        ));
        await tester.pumpAndSettle();

        // Find and tap sign out
        await tester.tap(find.text('Sign Out'));
        await tester.pumpAndSettle();

        // Assert: Confirmation dialog appears
        expect(find.text('Sign out of your account'), findsOneWidget);
        expect(find.text('Cancel'), findsOneWidget);
        expect(find.text('Sign Out'), findsNWidgets(2)); // Original + dialog
      });

      testWidgets('theme selection dialog works', (tester) async {
        // Arrange
        final user = UserProfileFactory.createFreeUser();

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(user),
        ));
        await tester.pumpAndSettle();

        // Find theme setting and tap
        final themeListTile = find.ancestor(
          of: find.text('Light'),
          matching: find.byType(ListTile),
        );
        await tester.tap(themeListTile);
        await tester.pumpAndSettle();

        // Assert: Theme dialog appears
        expect(find.text('Choose Theme'), findsOneWidget);
        expect(find.text('Light'), findsNWidgets(2)); // Original + dialog
        expect(find.text('Dark'), findsOneWidget);
        expect(find.text('System'), findsOneWidget);
      });

      testWidgets('language selection dialog works', (tester) async {
        // Arrange
        final user = UserProfileFactory.createFreeUser();

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(user),
        ));
        await tester.pumpAndSettle();

        // Find language setting and tap
        final languageListTile = find.ancestor(
          of: find.text('English'),
          matching: find.byType(ListTile),
        );
        await tester.tap(languageListTile);
        await tester.pumpAndSettle();

        // Assert: Language dialog appears
        expect(find.text('Choose Language'), findsOneWidget);
        expect(find.text('English'), findsNWidgets(2)); // Original + dialog
        expect(find.text('Italiano'), findsOneWidget);
      });
    });

    group('Cloud Sync Features', () {
      testWidgets('premium user can access sync from cloud', (tester) async {
        // Arrange
        final premiumUser = UserProfileFactory.createPremiumUser();

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(premiumUser),
        ));
        await tester.pumpAndSettle();

        // Find and tap sync from cloud
        await tester.tap(find.text('Sync from Cloud'));
        await tester.pumpAndSettle();

        // Assert: Confirmation dialog appears
        expect(find.text('📥 Sync from Cloud'), findsOneWidget);
        expect(find.text('Continue?'), findsOneWidget);
        expect(find.text('Sync Now'), findsOneWidget);
      });

      testWidgets('admin user has access to admin tools', (tester) async {
        // Arrange
        final adminUser = UserProfileFactory.createPremiumUser(
          email: 'michele.cozzolino93@gmail.com', // Admin email
        );

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(adminUser),
        ));
        await tester.pumpAndSettle();

        // Assert: Admin tools section exists
        expect(find.text('🔧 Admin Tools'), findsOneWidget);
        expect(find.text('Force Full Cloud Sync'), findsOneWidget);
        
        // Test admin sync button
        await tester.tap(find.text('Force Full Cloud Sync'));
        await tester.pumpAndSettle();

        expect(find.text('🔧 Force Full Cloud Sync'), findsOneWidget);
        expect(find.text('Force Sync'), findsOneWidget);
      });
    });

    group('Error Handling', () {
      testWidgets('handles missing user data gracefully', (tester) async {
        // Arrange: User with minimal data
        final minimalUser = UserProfile(
          uid: 'minimal',
          email: '',
          displayName: 'Minimal User',
          accountTier: AccountTier.free,
          templateQuota: TemplateQuota.forTier(AccountTier.free),
          createdAt: DateTime.now(),
          lastLoginAt: DateTime.now(),
          preferences: const UserPreferences(),
          stats: const UserStats(),
        );

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(minimalUser),
        ));
        await tester.pumpAndSettle();

        // Assert: Should not crash, displays what's available
        expect(find.text('Minimal User'), findsOneWidget);
        expect(find.byType(SettingsScreen), findsOneWidget);
      });

      testWidgets('back button navigation works correctly', (tester) async {
        // Arrange
        final user = UserProfileFactory.createFreeUser();

        // Act
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(user),
        ));
        await tester.pumpAndSettle();

        // Find and tap back button
        await tester.tap(find.byIcon(Icons.arrow_back));
        await tester.pumpAndSettle();

        // Note: In real app this would navigate, in test it just calls pop
        // The test verifies the button exists and is tappable
        expect(find.byIcon(Icons.arrow_back), findsOneWidget);
      });
    });

    group('Performance & Rebuild Testing', () {
      testWidgets('does not rebuild unnecessarily', (tester) async {
        // This test would ideally use a rebuild counter
        // For now, we verify the widget structure is stable
        
        // Arrange
        final user = UserProfileFactory.createFreeUser();

        // Act: First build
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(user),
        ));
        await tester.pumpAndSettle();

        // Count widgets first time
        final cardCount1 = tester.widgetList(find.byType(Card)).length;

        // Act: Trigger rebuild with same data
        await tester.pumpWidget(createTestSettingsScreen(
          userState: UserAuthenticated(user),
        ));
        await tester.pumpAndSettle();

        // Count widgets second time
        final cardCount2 = tester.widgetList(find.byType(Card)).length;

        // Assert: Widget count should be stable
        expect(cardCount1, equals(cardCount2));
      });
    });
  });
}